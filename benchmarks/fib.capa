// Pure-arithmetic benchmark: naive recursive Fibonacci. This is
// the worst case for the Python backend's overhead, because `fib`
// is almost entirely Int add/subtract and every Int op routes
// through an overflow-checked helper (`_capa_iadd` / `_capa_isub`)
// that traps at the same input the Wasm backend traps on. The
// resulting ratio (~3.5x vs hand Python) is the cost of the
// loud-overflow security guarantee, not of the call path itself.

fun fib(n: Int) -> Int
    if n < 2
        return n
    return fib(n - 1) + fib(n - 2)

fun main(stdio: Stdio)
    let r = fib(25)
    stdio.println("fib(25) = ${r}")
