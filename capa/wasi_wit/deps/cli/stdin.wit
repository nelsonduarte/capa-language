// SPDX-License-Identifier: Apache-2.0 WITH LLVM-exception
// Provenance: vendored from WebAssembly/wasi-cli, tag v0.2.0 (wit/stdio.wit).
//
// Vendored subset of the canonical WASI Preview 2 cli stdin
// interface.
//
// Source: WebAssembly/wasi-cli, tag v0.2.0
//   https://github.com/WebAssembly/wasi-cli/blob/v0.2.0/wit/stdio.wit
//
// Trimmed to the get-stdin() reader Capa's experimental --wasi mode
// imports (Stdio.read_line -> get-stdin -> input-stream, read
// byte-at-a-time via wasi:io/streams.input-stream.blocking-read until a
// "\n" or EOF). Split out of the upstream stdio.wit (which declares
// stdin / stdout / stderr together) into one file per interface so each
// is independently greppable; see stdout.wit for the shared rationale.
// Same wasi:cli@0.2.0 package as environment.wit / stdout.wit /
// stderr.wit; wasm-tools merges the package's .wit files when resolving
// deps/cli/.
//
// Canonical-ABI / unit conventions matching the host wasmtime
// add_wasip2() provides:
//   get-stdin -> input-stream : an OWNED input-stream handle the guest
//     reads the program's standard input from (via
//     input-stream.blocking-read in 1-byte chunks, stopping at the first
//     "\n" or at end-of-input signalled by stream-error::closed), then
//     drops. The underlying stdin POSITION is owned by the host
//     descriptor, not this resource, so a fresh get-stdin + drop per
//     read_line preserves the read cursor across calls (the --wasi host
//     feeds stdin via a WasiConfig stdin_file; see
//     capa.runtime._wasm_component_host).
//
// The ``package wasi:cli@0.2.0;`` declaration lives ONLY in
// environment.wit (the first cli file): wasm-tools merges every .wit
// file in deps/cli/ into one package and rejects doc comments attached
// to more than one ``package`` item, so this file omits the package
// line and contributes only its interface to the shared package.

interface stdin {
  use wasi:io/streams@0.2.0.{input-stream};

  get-stdin: func() -> input-stream;
}
