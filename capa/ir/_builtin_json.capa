// Bundled JSON parser/serializer for Capa's Wasm backend.
//
// The Wasm build emits ``parse_json`` / ``to_json`` calls into
// ``__capa_parse_json`` / ``__capa_to_json`` so the Component Model
// surface (``--wasm --component``) has no host import for JSON --
// the JsonValue tree is materialised in the component's own linear
// memory through the standard Capa allocators (variant constructors
// + List.push + Map.set). That keeps the canonical-ABI boundary
// memory-clean while preserving the existing JsonValue dispatch
// (.as_object / .as_string / ...) which dereferences pointers.

// Returns ``Ok((value, new_pos))`` on a parse, ``Err(msg)`` on
// failure. The wrapper ``__capa_parse_json`` uses the trailing
// position to reject garbage after the top-level value (Python's
// json.loads raises "Extra data" for ``1 2``); everything internal
// threads it through.

// Representation note (2026-06-10): the parser threads a
// ``List<String>`` of one-codepoint views built once per
// ``parse_json`` call (``for c in s`` binds views, no copies), so
// every per-character probe is O(1). The previous revision probed
// with ``s.substring(p, p + 1)`` -- O(p) per probe on the Wasm
// backend (code-point to byte-offset translation walks from the
// start) -- and accumulated string contents one character at a
// time through the bump allocator (no free), which is O(n^2)
// bytes of allocation. A 70 KiB JSON string needed ~2.5 GiB of
// bump allocation and trapped at the 16 MiB memory cap where the
// Python backend returned Ok. String contents now come out as a
// single ``substring`` when no escape is present, or as
// between-escape chunks otherwise.

// Audit 2026-05-25 H4: the recursive descent in __cj_parse_value
// / __cj_parse_array / __cj_parse_object has no nesting cap. An
// adversarial input like ``[[[[ ... ]]]]`` runs the parser until
// it hits the Wasm stack limit (trap) or, on hosts that grew the
// stack, recurses deep enough to make ``parse_json`` a DoS surface
// for any Capa module exposing JSON parsing to untrusted input.
// Python's ``json`` module caps at ~1000 internally; we cap at 100
// since the typical Capa use case (config files, simple records)
// never approaches that, and a lower limit fails fast.
const __CJ_MAX_DEPTH: Int = 100

pub fun __capa_parse_json(s: String) -> Result<JsonValue, String>
    var chars: List<String> = []
    for c in s
        chars.push(c)
    let start = __cj_skip_ws(chars, 0)
    match __cj_parse_value(s, chars, start, 0)
        Ok(jv_pos) ->
            let (jv, after) = jv_pos
            // RFC 8259: a JSON text is ONE value (plus whitespace).
            // Anything left after the top-level value is an error;
            // Python's json.loads raises "Extra data" for ``1 2``.
            let trailing = __cj_skip_ws(chars, after)
            if trailing < chars.length()
                return Err("Extra data at ${trailing}")
            return Ok(jv)
        Err(msg) -> return Err(msg)

// RFC 8259 section 7: raw control characters (U+0000..U+001F) are
// not allowed inside a JSON string; they must be escaped. The
// haystack below is exactly those 32 code points, so a one-char
// probe ``contains`` answers "is this a control char" without an
// ord() builtin. Python's ``json.loads`` rejects the same set
// ("Invalid control character"), so both backends return Err.
fun __cj_is_ctrl(c: String) -> Bool
    return "\u{0}\u{1}\u{2}\u{3}\u{4}\u{5}\u{6}\u{7}\u{8}\u{9}\u{a}\u{b}\u{c}\u{d}\u{e}\u{f}\u{10}\u{11}\u{12}\u{13}\u{14}\u{15}\u{16}\u{17}\u{18}\u{19}\u{1a}\u{1b}\u{1c}\u{1d}\u{1e}\u{1f}".contains(c)

// The eight escape introducers RFC 8259 allows after a backslash.
// Anything else ("\q", "\x", a raw control char) is a parse error,
// matching Python's "Invalid \escape".
fun __cj_is_valid_escape(e: String) -> Bool
    return "\"\\/bfnrtu".contains(e)

fun __cj_is_number_char(c: String) -> Bool
    return "0123456789.eE+-".contains(c)

fun __cj_is_digit(c: String) -> Bool
    return "0123456789".contains(c)

// First position >= pos that is not a decimal digit (capped at end).
fun __cj_skip_digits(chars: List<String>, pos: Int, end: Int) -> Int
    var p = pos
    while p < end
        if __cj_is_digit(chars[p])
            p = p + 1
        else
            return p
    return p

// RFC 8259 number grammar:
//   -?(0|[1-9][0-9]*)(\.[0-9]+)?([eE][+-]?[0-9]+)?
// The token scan in __cj_parse_number is deliberately greedy over
// "0123456789.eE+-", so the raw token can be garbage Python's json
// rejects ("01", "-01", "1.", ".5", "+1", "1e", "--1"). Validate
// the exact shape before handing the text to parse_float -- the
// Wasm parse_float is lenient about leading zeros and bare dots,
// which made the bundled parser accept non-JSON numbers the
// Python backend errors on.
fun __cj_number_token_valid(chars: List<String>, start: Int, end: Int) -> Bool
    var p = start
    if p < end
        if chars[p] == "-"
            p = p + 1
    if p >= end
        return false
    // Integer part: a single 0, or a 1-9 digit run. A leading zero
    // followed by more digits ("01") fails the p == end check below.
    if chars[p] == "0"
        p = p + 1
    else
        let after_int = __cj_skip_digits(chars, p, end)
        if after_int == p
            return false
        p = after_int
    // Optional fraction: "." requires at least one digit after it.
    if p < end
        if chars[p] == "."
            let after_frac = __cj_skip_digits(chars, p + 1, end)
            if after_frac == p + 1
                return false
            p = after_frac
    // Optional exponent: e/E, optional sign, at least one digit.
    if p < end
        if chars[p] == "e" or chars[p] == "E"
            p = p + 1
            if p < end
                if chars[p] == "+" or chars[p] == "-"
                    p = p + 1
            let after_exp = __cj_skip_digits(chars, p, end)
            if after_exp == p
                return false
            p = after_exp
    return p == end

fun __cj_skip_ws(chars: List<String>, pos: Int) -> Int
    var p = pos
    let n = chars.length()
    while p < n
        let c = chars[p]
        if c == " " or c == "\t" or c == "\n" or c == "\r"
            p = p + 1
        else
            return p
    return p

fun __cj_parse_value(s: String, chars: List<String>, pos: Int, depth: Int) -> Result<(JsonValue, Int), String>
    if depth > __CJ_MAX_DEPTH
        return Err("max nesting depth ${__CJ_MAX_DEPTH} exceeded at ${pos}")
    if pos >= chars.length()
        return Err("unexpected end at ${pos}")
    let c = chars[pos]
    if c == "n"
        return __cj_parse_null(chars, pos)
    if c == "t" or c == "f"
        return __cj_parse_bool(chars, pos)
    if c == "\""
        return __cj_parse_string(s, chars, pos)
    if c == "["
        return __cj_parse_array(s, chars, pos, depth + 1)
    if c == "{"
        return __cj_parse_object(s, chars, pos, depth + 1)
    return __cj_parse_number(s, chars, pos)

fun __cj_parse_null(chars: List<String>, pos: Int) -> Result<(JsonValue, Int), String>
    if pos + 3 < chars.length()
        if chars[pos + 1] == "u" and chars[pos + 2] == "l" and chars[pos + 3] == "l"
            return Ok((JNull, pos + 4))
    return Err("expected 'null' at ${pos}")

fun __cj_parse_bool(chars: List<String>, pos: Int) -> Result<(JsonValue, Int), String>
    let n = chars.length()
    if chars[pos] == "t"
        if pos + 3 < n
            if chars[pos + 1] == "r" and chars[pos + 2] == "u" and chars[pos + 3] == "e"
                return Ok((JBool(true), pos + 4))
        return Err("expected true/false at ${pos}")
    if pos + 4 < n
        if chars[pos + 1] == "a" and chars[pos + 2] == "l" and chars[pos + 3] == "s" and chars[pos + 4] == "e"
            return Ok((JBool(false), pos + 5))
    return Err("expected true/false at ${pos}")

// Hex digit value for one character: 0..15, or -1 when ``c`` is
// not a hex digit. Both cases accepted, like Python's json.
fun __cj_hex_val(c: String) -> Int
    match "0123456789abcdef".index_of(c)
        Some(i) -> return i
        None ->
            match "ABCDEF".index_of(c)
                Some(i) -> return i + 10
                None    -> return -1

// Parse the four hex digits of a \uXXXX escape starting at ``p``
// (the first digit, i.e. just after the "u"). Returns the value
// 0..0xFFFF, or -1 when a digit is missing or invalid -- the same
// inputs Python's json rejects with "Invalid \uXXXX escape".
fun __cj_u4(chars: List<String>, p: Int) -> Int
    if p + 3 >= chars.length()
        return -1
    var v = 0
    var i = 0
    while i < 4
        let d = __cj_hex_val(chars[p + i])
        if d < 0
            return -1
        v = v * 16 + d
        i = i + 1
    return v

// Parse a JSON string starting at ``pos`` (the opening quote).
// Returns the decoded String and the position just after the
// closing quote.
//
// Two passes. The scan pass finds the closing quote, rejects raw
// control characters (RFC 8259 section 7), invalid escape
// introducers, and \u escapes without four hex digits, and records
// whether any escape occurred. When the scan saw no escape, the
// value is one ``substring`` -- a single allocation, so 100 KiB+
// strings parse in linear memory. With escapes, the decode pass
// copies the runs between escapes as chunks and splices the decoded
// escape characters in between.
//
// Handles \" \\ \/ \b \f \n \r \t and \uXXXX. \uXXXX decodes to
// the real code point via the internal ``_capa_chr`` builtin,
// replicating Python's json semantics exactly:
//
// - a high surrogate (D800..DBFF) immediately followed by a low
//   surrogate escape (\uDC00..\uDFFF) combines into one astral
//   code point ("😀" -> U+1F600, the emoji);
// - an UNPAIRED surrogate is kept as-is as a lone code point
//   (json.loads('"\ud800"') returns '\ud800', length 1 -- it does
//   NOT error). On the Wasm side the lone surrogate is stored as
//   WTF-8 bytes, which keeps length() / substring() / comparisons
//   in codepoint parity with Python; note Python itself cannot
//   PRINT that string (UnicodeEncodeError at the stdout encoder),
//   so byte-exact print parity is moot for unpaired surrogates.
fun __cj_parse_string(s: String, chars: List<String>, pos: Int) -> Result<(JsonValue, Int), String>
    let n = chars.length()
    var p = pos + 1
    var has_escape = false
    var close = -1
    while p < n
        let c = chars[p]
        if c == "\""
            close = p
            break
        if c == "\\"
            has_escape = true
            if p + 1 >= n
                return Err("bad escape at ${p}")
            let e = chars[p + 1]
            if not __cj_is_valid_escape(e)
                return Err("invalid escape at ${p}")
            if e == "u"
                // Four hex digits required; the closing quote is
                // not a hex digit, so a truncated escape ("\u00")
                // fails here exactly like Python's
                // "Invalid \uXXXX escape".
                if __cj_u4(chars, p + 2) < 0
                    return Err("invalid \\uXXXX escape at ${p}")
                p = p + 6
            else
                p = p + 2
        else
            if __cj_is_ctrl(c)
                return Err("invalid control character at ${p}")
            p = p + 1
    if close < 0
        return Err("unterminated string at ${pos}")
    if not has_escape
        return Ok((JStr(s.substring(pos + 1, close)), close + 1))
    // Decode pass: copy between-escape runs as chunks.
    var out = ""
    var run_start = pos + 1
    p = pos + 1
    while p < close
        if chars[p] == "\\"
            if run_start < p
                out = out + s.substring(run_start, p)
            let e = chars[p + 1]
            if e == "u"
                // Scan pass guaranteed four valid hex digits for
                // every \u inside the string, this one included.
                let h1 = __cj_u4(chars, p + 2)
                var cp = h1
                var consumed = 6
                if h1 >= 55296 and h1 <= 56319
                    // High surrogate: combine with an immediately
                    // following low-surrogate escape (Python json
                    // pairs ONLY the contiguous \uXXXX\uXXXX shape;
                    // anything else leaves the surrogate unpaired).
                    if p + 7 < n
                        if chars[p + 6] == "\\" and chars[p + 7] == "u"
                            let h2 = __cj_u4(chars, p + 8)
                            if h2 >= 56320 and h2 <= 57343
                                cp = 65536 + (h1 - 55296) * 1024 + (h2 - 56320)
                                consumed = 12
                out = out + _capa_chr(cp)
                p = p + consumed
            else
                if e == "n"
                    out = out + "\n"
                else
                    if e == "t"
                        out = out + "\t"
                    else
                        if e == "r"
                            out = out + "\r"
                        else
                            if e == "b"
                                out = out + "\u{8}"
                            else
                                if e == "f"
                                    out = out + "\u{c}"
                                else
                                    // " \ / decode to themselves.
                                    out = out + e
                p = p + 2
            run_start = p
        else
            p = p + 1
    if run_start < close
        out = out + s.substring(run_start, close)
    return Ok((JStr(out), close + 1))

// Parse a number: optional minus, integer part, optional fraction,
// optional exponent. The token boundary is the next char that is
// not in ``0123456789.eE+-``. Routes through the built-in
// ``parse_float`` (already a Wasm runtime helper) for the actual
// conversion.
fun __cj_parse_number(s: String, chars: List<String>, pos: Int) -> Result<(JsonValue, Int), String>
    let n = chars.length()
    var p = pos
    if p < n
        if chars[p] == "-"
            p = p + 1
    while p < n
        if __cj_is_number_char(chars[p])
            p = p + 1
        else
            return __cj_finish_number(s, chars, pos, p)
    return __cj_finish_number(s, chars, pos, p)

fun __cj_finish_number(s: String, chars: List<String>, start: Int, end: Int) -> Result<(JsonValue, Int), String>
    if start == end
        return Err("expected number at ${start}")
    let text = s.substring(start, end)
    if not __cj_number_token_valid(chars, start, end)
        return Err("bad number '${text}' at ${start}")
    // Python's json parses integer-form tokens (no fraction, no
    // exponent) through int(), so "-0" collapses to integer zero
    // and the sign is lost (json.loads("-0") == 0). parse_float
    // would keep IEEE -0.0 here; collapse to +0.0 to match. The
    // grammar above guarantees "-0" is the only integer-form
    // negative-zero spelling ("-00" is invalid).
    if text == "-0"
        return Ok((JNum(0.0), end))
    match parse_float(text)
        Some(f) -> return Ok((JNum(f), end))
        None    -> return Err("bad number '${text}' at ${start}")

fun __cj_parse_array(s: String, chars: List<String>, pos: Int, depth: Int) -> Result<(JsonValue, Int), String>
    var items: List<JsonValue> = []
    var p = __cj_skip_ws(chars, pos + 1)
    let n = chars.length()
    if p < n
        if chars[p] == "]"
            return Ok((JArr(items), p + 1))
    while p < n
        match __cj_parse_value(s, chars, p, depth)
            Err(msg) -> return Err(msg)
            Ok(jv_pos) ->
                let (jv, after) = jv_pos
                items.push(jv)
                p = __cj_skip_ws(chars, after)
                if p >= n
                    return Err("unterminated array")
                let sep = chars[p]
                if sep == "]"
                    return Ok((JArr(items), p + 1))
                if sep == ","
                    p = __cj_skip_ws(chars, p + 1)
                else
                    return Err("expected , or ] at ${p}, got '${sep}'")
    return Err("unterminated array")

fun __cj_parse_object(s: String, chars: List<String>, pos: Int, depth: Int) -> Result<(JsonValue, Int), String>
    var obj: Map<String, JsonValue> = new_map()
    var p = __cj_skip_ws(chars, pos + 1)
    let n = chars.length()
    if p < n
        if chars[p] == "}"
            return Ok((JObj(obj), p + 1))
    while p < n
        if chars[p] != "\""
            return Err("expected key string at ${p}")
        let k_res = __cj_parse_string(s, chars, p)
        match k_res
            Err(msg) -> return Err(msg)
            Ok(k_pos) ->
                let (k_jv, after_k) = k_pos
                let key = match k_jv.as_string()
                    Some(k) -> k
                    None    -> ""
                p = __cj_skip_ws(chars, after_k)
                if p >= n
                    return Err("expected ':' at end")
                if chars[p] != ":"
                    return Err("expected ':' at ${p}")
                p = __cj_skip_ws(chars, p + 1)
                match __cj_parse_value(s, chars, p, depth)
                    Err(msg) -> return Err(msg)
                    Ok(v_pos) ->
                        let (v_jv, after_v) = v_pos
                        obj.set(key, v_jv)
                        p = __cj_skip_ws(chars, after_v)
                        if p >= n
                            return Err("unterminated object")
                        let sep = chars[p]
                        if sep == "}"
                            return Ok((JObj(obj), p + 1))
                        if sep == ","
                            p = __cj_skip_ws(chars, p + 1)
                        else
                            return Err("expected , or } at ${p}")
    return Err("unterminated object")

// =====================================================
// Serializer
// =====================================================

pub fun __capa_to_json(jv: JsonValue) -> String
    if jv.is_null()
        return "null"
    match jv.as_bool()
        Some(b) -> return match b
            true  -> "true"
            false -> "false"
        None -> ""
    match jv.as_num()
        Some(f) -> return __cj_num_to_string(f)
        None -> ""
    match jv.as_string()
        Some(s) -> return __cj_quote_string(s)
        None -> ""
    match jv.as_array()
        Some(xs) -> return __cj_array_to_string(xs)
        None -> ""
    match jv.as_object()
        Some(m) -> return __cj_object_to_string(m)
        None -> ""
    return "null"

fun __cj_num_to_string(f: Float) -> String
    // ``${f}`` triggers the runtime's ftoa, which always emits a
    // decimal point plus six fractional digits. Strip trailing
    // zeros from the fraction (``1.500000`` -> ``1.5``) and the
    // dot itself when no fractional digit survives (``3.000000``
    // -> ``3``) so the JSON output matches the canonical
    // ``json.dumps`` rendering.
    let raw = "${f}"
    let n = raw.length()
    // Locate the dot by linear scan (index_of is not yet wired in
    // the Wasm backend; substring-equality is enough).
    var dot = 0
    while dot < n and raw.substring(dot, dot + 1) != "."
        dot = dot + 1
    if dot >= n
        return raw
    var end = n
    while end > dot + 1 and raw.substring(end - 1, end) == "0"
        end = end - 1
    if end == dot + 1
        let ipart = raw.substring(0, dot)
        // Negative zero: json.dumps(-0.0) keeps both the sign and
        // the fraction ("-0.0"); collapsing to "-0" loses the
        // round-trip with the Python backend, which keeps -0.0 as
        // a float exactly so the sign survives serialisation.
        if ipart == "-0"
            return "-0.0"
        return ipart
    return raw.substring(0, end)

// Quote + escape a string value, chunked: the runs between
// escapable characters are copied with one ``substring`` each, so
// serialising a large mostly-clean string is linear instead of the
// previous one-allocation-per-character accumulation. Control
// characters below 0x20 without a short escape come out as
// ``\u00XX`` (lowercase hex), matching ``json.dumps``.
fun __cj_quote_string(s: String) -> String
    var out = "\""
    var run_start = 0
    var p = 0
    for c in s
        if c == "\"" or c == "\\" or __cj_is_ctrl(c)
            if run_start < p
                out = out + s.substring(run_start, p)
            out = out + __cj_escape_char(c)
            run_start = p + 1
        p = p + 1
    if run_start < p
        out = out + s.substring(run_start, p)
    return out + "\""

fun __cj_escape_char(c: String) -> String
    if c == "\""
        return "\\\""
    if c == "\\"
        return "\\\\"
    if c == "\n"
        return "\\n"
    if c == "\t"
        return "\\t"
    if c == "\r"
        return "\\r"
    if c == "\u{8}"
        return "\\b"
    if c == "\u{c}"
        return "\\f"
    // Any other control char: \u00XX. The control-char haystack
    // doubles as an ord() table -- each code point sits at the
    // index equal to its value, so index_of gives the codepoint.
    let k = match "\u{0}\u{1}\u{2}\u{3}\u{4}\u{5}\u{6}\u{7}\u{8}\u{9}\u{a}\u{b}\u{c}\u{d}\u{e}\u{f}\u{10}\u{11}\u{12}\u{13}\u{14}\u{15}\u{16}\u{17}\u{18}\u{19}\u{1a}\u{1b}\u{1c}\u{1d}\u{1e}\u{1f}".index_of(c)
        Some(i) -> i
        None    -> 0
    let hex = "0123456789abcdef"
    let hi = k / 16
    let lo = k % 16
    return "\\u00" + hex.substring(hi, hi + 1) + hex.substring(lo, lo + 1)

fun __cj_array_to_string(xs: List<JsonValue>) -> String
    var out = "["
    var first = true
    for x in xs
        if not first
            out = out + ", "
        out = out + __capa_to_json(x)
        first = false
    out = out + "]"
    return out

fun __cj_object_to_string(m: Map<String, JsonValue>) -> String
    var out = "{"
    var first = true
    for pair in m.pairs()
        let (k, v) = pair
        if not first
            out = out + ", "
        out = out + __cj_quote_string(k)
        out = out + ": "
        out = out + __capa_to_json(v)
        first = false
    out = out + "}"
    return out
