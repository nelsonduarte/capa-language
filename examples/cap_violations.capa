// cap_violations.capa, program that violates the capability discipline.
// Each top-level item should produce a distinct analyzer error.

// 1. Capability as struct field, forbidden
type Service {
    stdio: Stdio,
    name: String
}

// 2. Capability as variant payload, forbidden
type Resource =
    Text(String)
    Output(Stdio)

// 3. Capability as return type, forbidden
fun make() -> Stdio
    return Stdio { }

// 4. Capability as constant type, forbidden
const STDOUT: Stdio = Stdio { }

// 5. Capability inside a generic type, forbidden
fun cap_list() -> List<Stdio>
    return []

// 6. Capability bound in a local let, forbidden
fun use_cap(stdio: Stdio)
    let copy = stdio
    copy.println("oops")

// 7. Capability in var, forbidden
fun move_cap(stdio: Stdio)
    var s: Stdio = stdio
    s.println("oops")

// 8. Capability inside a tuple, forbidden
fun in_tuple() -> (Stdio, Int)
    return (Stdio { }, 0)

// 9. Capability nested in a container parameter, forbidden
fun sink_list(caps: List<Stdio>)
    caps[0].println("oops")

// 10. Capability inserted into a container via a mutator, forbidden
fun populate(stdio: Stdio)
    var xs = []
    xs.push(stdio)

// 11. Capability read out of an inferred-then-populated container,
//     forbidden. The element type only resolves after the push, so the
//     end-of-function deferred recheck catches the read.
fun read_out(stdio: Stdio)
    var xs = []
    xs.push(stdio)
    xs[0].println("oops")

// 12. Capability iterated out of a container literal, forbidden
fun iterate(stdio: Stdio)
    for c in [stdio]
        c.println("oops")

// 13. Capability read out through a higher-order method whose closure
//     would receive it, forbidden
fun higher_order(stdio: Stdio)
    let _ = [stdio].map(fun (c: Stdio) -> Int => leak(c))

fun leak(c: Stdio) -> Int
    c.println("oops")
    return 0
