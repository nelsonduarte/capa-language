fun validate_cyclonedx(doc: CdxDocument) -> List<String>
    let refs = collect_bom_refs(doc)
    let errors: List<String> = []
    for d in doc.dependencies
        if not refs.contains(d.ref)
            errors.push("dependency 'ref' '${d.ref}' is not a known bom-ref")
        for child in d.depends_on
            if not refs.contains(child)
                errors.push("dependency target '${child}' is not a known bom-ref")
    for v in doc.vulnerabilities
        for a in v.affects
            if not refs.contains(a.ref)
                errors.push("vulnerability '${v.id}' affects unknown bom-ref '${a.ref}'")
    for v in doc.vulnerabilities
        for r in v.ratings
            if not is_valid_severity(r.severity)
                errors.push("vulnerability '${v.id}' has rating with invalid severity '${r.severity}'")
        if v.analysis.state != "" and not is_valid_analysis_state(v.analysis.state)
            errors.push("vulnerability '${v.id}' has analysis with invalid state '${v.analysis.state}'")
    for s in doc.services
        for d in s.data
            if not is_valid_data_flow(d.flow)
                errors.push("service '${s.name}' has data classification with invalid flow '${d.flow}'")
    for c in doc.components
        if c.has_evidence
            if c.evidence.has_identity
                if c.evidence.identity.field != "" and not is_valid_identity_field(c.evidence.identity.field)
                    errors.push("component '${c.name}' has evidence.identity.field with invalid value '${c.evidence.identity.field}'")
                if c.evidence.identity.confidence < 0.0 or c.evidence.identity.confidence > 1.0
                    errors.push("component '${c.name}' has evidence.identity.confidence out of [0.0, 1.0]")
                for m in c.evidence.identity.methods
                    if not is_valid_identity_technique(m.technique)
                        errors.push("component '${c.name}' has identity method with invalid technique '${m.technique}'")
                    if m.confidence < 0.0 or m.confidence > 1.0
                        errors.push("component '${c.name}' has identity method confidence out of [0.0, 1.0]")
    for c in doc.components
        for er in c.external_references
            if not is_valid_external_ref_type(er.kind)
                errors.push("component '${c.name}' has externalReference with invalid type '${er.kind}'")
            if er.url == ""
                errors.push("component '${c.name}' has externalReference with empty url")
    if doc.has_signature
        if not is_valid_signature_algorithm(doc.signature.algorithm)
            errors.push("signature.algorithm '${doc.signature.algorithm}' is not a supported JSF algorithm")
        if doc.signature.value == ""
            errors.push("signature.value is empty (signature must carry a base64-encoded value)")
    let known_vuln_refs: Set<String> = new_set()
    for v in doc.vulnerabilities
        if v.bom_ref != ""
            known_vuln_refs.add(v.bom_ref)
    for comp in doc.compositions
        if not is_valid_aggregate(comp.aggregate)
            errors.push("composition has aggregate with invalid value '${comp.aggregate}'")
        for a in comp.assemblies
            if not refs.contains(a)
                errors.push("composition assembly '${a}' is not a known bom-ref")
        for d in comp.dependencies
            if not refs.contains(d)
                errors.push("composition dependency '${d}' is not a known bom-ref")
        for vref in comp.vulnerabilities
            if not known_vuln_refs.contains(vref)
                errors.push("composition vulnerability '${vref}' is not a known vulnerability bom-ref")
    match detect_cyclonedx_cycle(doc)
        None ->
            ()
        Some(node) ->
            errors.push("dependency graph contains a cycle through '${node}'")
    return errors

// ---- validation: cycle detection ----
//
// The CycloneDX dependsOn[] graph must be a DAG: a cycle ("A
// depends on B depends on A") is either a SBOM-generation bug
// or a sign of corrupted dependency resolution. Same classic
// three-colour DFS as the SPDX side: white = unvisited (not in
// any set), gray = in_progress (on the DFS stack), black = done
// (fully explored). A gray-edge encounter signals the cycle.
// Returns Some(witness) with an arbitrary node from the cycle,
// or None when the graph is acyclic.

fun build_cdx_adj(doc: CdxDocument) -> Map<String, List<String>>
    let adj: Map<String, List<String>> = new_map()
    for d in doc.dependencies
        let existing = match adj.get(d.ref)
            None -> []
            Some(xs) -> xs
        for child in d.depends_on
            existing.push(child)
        adj.set(d.ref, existing)
    return adj

fun has_cycle_from(
    adj: Map<String, List<String>>,
    node: String,
    in_progress: Set<String>,
    done: Set<String>
) -> Option<String>
    if done.contains(node)
        return None
    if in_progress.contains(node)
        return Some(node)
    in_progress.add(node)
    let children = match adj.get(node)
        None -> []
        Some(xs) -> xs
    for c in children
        match has_cycle_from(adj, c, in_progress, done)
            None ->
                ()
            Some(witness) ->
                return Some(witness)
    in_progress.remove(node)
    done.add(node)
    return None

fun detect_cyclonedx_cycle(doc: CdxDocument) -> Option<String>
    let adj = build_cdx_adj(doc)
    let in_progress: Set<String> = new_set()
    let done: Set<String> = new_set()
    let refs = collect_bom_refs(doc)
    for n in refs.to_list()
        match has_cycle_from(adj, n, in_progress, done)
            None ->
                ()
            Some(witness) ->
                return Some(witness)
    return None

// ---- demo ----

// Format an externalReference type as a bracketed, fixed-width
// tag so the trailing URL lines up across rows. Width of 10
// covers the common short types (website, vcs, bom, support,
// ...); longer report-type values will overflow but the demo
// only exercises the short ones.
fun fmt_ref_tag(t: String) -> String
    var s = "[" + t + "]"
    while s.length() < 10
        s = s + " "
    return s

fun main(stdio: Stdio)
    // A trimmed CycloneDX 1.5 document: one program component, two
    // dependency components (a lib + a transitive lib), and a
    // small dependency graph linking them. Mirrors the kind of
    // SBOM the Capa compiler itself emits via --cyclonedx.
    let sample = "{\"bomFormat\": \"CycloneDX\", \"specVersion\": \"1.5\", \"serialNumber\": \"urn:uuid:11111111-2222-3333-4444-555555555555\", \"version\": 1, \"metadata\": {\"timestamp\": \"2026-05-13T10:00:00Z\", \"tools\": {\"components\": [{\"type\": \"application\", \"name\": \"capa\", \"version\": \"0.6.0-alpha\"}]}, \"component\": {\"bom-ref\": \"capa:program:demo\", \"type\": \"application\", \"name\": \"demo\", \"version\": \"1.0.0\"}}, \"components\": [{\"bom-ref\": \"pkg:npm/lodash@4.17.21\", \"type\": \"library\", \"name\": \"lodash\", \"version\": \"4.17.21\", \"purl\": \"pkg:npm/lodash@4.17.21\", \"hashes\": [{\"alg\": \"SHA-256\", \"content\": \"aaaabbbbccccddddeeeeffff0011223344556677889900aabbccddeeff001122\"}], \"licenses\": [{\"license\": {\"id\": \"MIT\"}}], \"externalReferences\": [{\"type\": \"website\", \"url\": \"https://lodash.com\", \"comment\": \"Project homepage\"}, {\"type\": \"vcs\", \"url\": \"https://github.com/lodash/lodash\"}], \"evidence\": {\"identity\": {\"field\": \"purl\", \"confidence\": 1.0, \"methods\": [{\"technique\": \"manifest-analysis\", \"confidence\": 1.0, \"value\": \"package-lock.json\"}]}, \"occurrences\": [{\"bom-ref\": \"occ-lodash-1\", \"location\": \"node_modules/lodash/index.js\"}], \"copyright\": [{\"text\": \"Copyright OpenJS Foundation and contributors\"}]}}, {\"bom-ref\": \"pkg:npm/chalk@5.3.0\", \"type\": \"library\", \"name\": \"chalk\", \"version\": \"5.3.0\", \"purl\": \"pkg:npm/chalk@5.3.0\", \"licenses\": [{\"expression\": \"MIT OR Apache-2.0\"}]}], \"dependencies\": [{\"ref\": \"capa:program:demo\", \"dependsOn\": [\"pkg:npm/lodash@4.17.21\", \"pkg:npm/chalk@5.3.0\"]}, {\"ref\": \"pkg:npm/chalk@5.3.0\", \"dependsOn\": [\"pkg:npm/lodash@4.17.21\"]}], \"vulnerabilities\": [{\"bom-ref\": \"vuln-CVE-2024-7890\", \"id\": \"CVE-2024-7890\", \"source\": {\"name\": \"NVD\"}, \"ratings\": [{\"severity\": \"high\", \"score\": 7.5, \"method\": \"CVSSv3\"}], \"cwes\": [79], \"description\": \"Cross-site scripting in lodash template helper\", \"recommendation\": \"Upgrade to lodash 4.17.22\", \"published\": \"2024-09-01T00:00:00Z\", \"updated\": \"2024-09-15T00:00:00Z\", \"affects\": [{\"ref\": \"pkg:npm/lodash@4.17.21\"}], \"analysis\": {\"state\": \"exploitable\", \"justification\": \"code-uses-vulnerable-template\", \"detail\": \"lodash _.template called with user input\"}}], \"services\": [{\"bom-ref\": \"service:stripe-api\", \"provider\": {\"name\": \"Stripe\", \"url\": [\"https://stripe.com\"]}, \"group\": \"com.stripe\", \"name\": \"payments-api\", \"version\": \"2024-06-20\", \"description\": \"Stripe charges API\", \"endpoints\": [\"https://api.stripe.com/v1/charges\"], \"authenticated\": true, \"x-trust-boundary\": true, \"data\": [{\"classification\": \"PII\", \"flow\": \"outbound\"}]}], \"signature\": {\"algorithm\": \"RS256\", \"keyId\": \"build-key-2024\", \"value\": \"MEUCIQDXamplebase64encodedsignaturebytesgoeshere1234567890\"}, \"compositions\": [{\"bom-ref\": \"composition-1\", \"aggregate\": \"incomplete\", \"assemblies\": [\"pkg:npm/lodash@4.17.21\"], \"dependencies\": [\"pkg:npm/chalk@5.3.0\"], \"vulnerabilities\": [\"vuln-CVE-2024-7890\"]}]}"

    match parse_cyclonedx(sample)
        Err(msg) ->
            stdio.eprintln("CycloneDX parse failed: ${msg}")
        Ok(doc) ->
            stdio.println("CycloneDX ${doc.spec_version} document")
            stdio.println("  serial:    ${doc.serial_number}")
            stdio.println("  version:   ${doc.version}")
            stdio.println("  generated: ${doc.metadata.timestamp}")
            stdio.println("  tools:     ${doc.metadata.tool_names.length()} entries")
            for t in doc.metadata.tool_names
                stdio.println("    - ${t}")
            stdio.println("  product:   ${doc.metadata.main_component_name} (${doc.metadata.main_component_ref})")
            stdio.println("")
            stdio.println("Components (${doc.components.length()}):")
            for c in doc.components
                stdio.println("  - [${c.kind}] ${c.name} ${c.version}")
                stdio.println("      bom-ref: ${c.bom_ref}")
                if c.purl != ""
                    stdio.println("      purl:    ${c.purl}")
                for h in c.hashes
                    stdio.println("      ${h.algorithm} = ${h.content}")
                for l in c.licenses
                    if l.expression != ""
                        stdio.println("      license: ${l.expression} (expression)")
                    if l.id != ""
                        stdio.println("      license: ${l.id} (SPDX id)")
                    if l.name != ""
                        stdio.println("      license: ${l.name} (name)")
                if c.has_evidence
                    stdio.println("      evidence:")
                    if c.evidence.has_identity
                        stdio.println("        identity: ${c.evidence.identity.field} @ ${c.evidence.identity.confidence}")
                        for m in c.evidence.identity.methods
                            stdio.println("          method: ${m.technique} @ ${m.confidence} (${m.value})")
                    if c.evidence.occurrences.length() != 0
                        stdio.println("        occurrences: ${c.evidence.occurrences.length()}")
                        for o in c.evidence.occurrences
                            stdio.println("          ${o.location}")
                    if c.evidence.copyright.length() != 0
                        stdio.println("        copyright: ${c.evidence.copyright.length()}")
                        for cp in c.evidence.copyright
                            stdio.println("          ${cp.text}")
                if not c.external_references.is_empty()
                    stdio.println("      external refs (${c.external_references.length()}):")
                    for er in c.external_references
                        let tag = fmt_ref_tag(er.kind)
                        if er.comment == ""
                            stdio.println("        - ${tag} ${er.url}")
                        else
                            stdio.println("        - ${tag} ${er.url} (${er.comment})")
            stdio.println("")
            stdio.println("Dependency edges (${doc.dependencies.length()}):")
            for d in doc.dependencies
                stdio.println("  - ${d.ref}")
                for child in d.depends_on
                    stdio.println("      -> ${child}")
            stdio.println("")
            stdio.println("Vulnerabilities (${doc.vulnerabilities.length()}):")
            for v in doc.vulnerabilities
                let severity = match v.ratings.get(0)
                    None -> "unknown"
                    Some(r) -> r.severity
                stdio.println("  - ${v.id} (${severity})")
                for a in v.affects
                    stdio.println("      affects: ${a.ref}")
                if v.analysis.state != ""
                    stdio.println("      analysis: ${v.analysis.state} (${v.analysis.justification})")
            stdio.println("")
            stdio.println("Services (${doc.services.length()}):")
            for s in doc.services
                stdio.println("  - ${s.name} ${s.version} (${s.group})")
                stdio.println("      provider: ${s.provider.name}")
                if s.endpoints.length() != 0
                    stdio.println("      endpoints: ${s.endpoints.length()}")
                let auth_s = if s.authenticated then "true" else "false"
                let tb_s = if s.x_trust_boundary then "true" else "false"
                stdio.println("      authenticated: ${auth_s}; trust-boundary: ${tb_s}")
                if s.data.length() != 0
                    stdio.println("      data: ${s.data.length()} classification(s)")
                    for d in s.data
                        stdio.println("        ${d.classification} (${d.flow})")
            stdio.println("")
            if doc.has_signature
                stdio.println("Signature: present")
                stdio.println("  algorithm: ${doc.signature.algorithm}")
                stdio.println("  key-id:    ${doc.signature.key_id}")
                let raw = doc.signature.value
                let shown = if raw.length() > 60 then raw.substring(0, 60) + "..." else raw
                stdio.println("  value:     ${shown}")
            else
                stdio.println("Signature: none")
            stdio.println("")
            stdio.println("Compositions (${doc.compositions.length()}):")
            for comp in doc.compositions
                if comp.bom_ref == ""
                    stdio.println("  - (${comp.aggregate})")
                else
                    stdio.println("  - ${comp.bom_ref} (${comp.aggregate})")
                if comp.assemblies.length() != 0
                    stdio.println("      assemblies (${comp.assemblies.length()}):")
                    for a in comp.assemblies
                        stdio.println("        - ${a}")
                if comp.dependencies.length() != 0
                    stdio.println("      dependencies (${comp.dependencies.length()}):")
                    for d in comp.dependencies
                        stdio.println("        - ${d}")
                if comp.vulnerabilities.length() != 0
                    stdio.println("      vulnerabilities (${comp.vulnerabilities.length()}):")
                    for vref in comp.vulnerabilities
                        stdio.println("        - ${vref}")
            stdio.println("")
            let violations = validate_cyclonedx(doc)
            if violations.is_empty()
                stdio.println("Validation: ok (refs resolve + acyclic)")
            else
                stdio.println("Validation: ${violations.length()} issue(s)")
                for v in violations
                    stdio.println("  - ${v}")
