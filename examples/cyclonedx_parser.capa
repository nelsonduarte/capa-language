// CycloneDX 1.5 JSON parser, the SBOM-of-record companion to
// examples/spdx_parser.capa. Together they show that Capa can
// mex with both ISO-blessed SBOM formats (SPDX 2.3 / ISO/IEC
// 5962:2021) and the OWASP-stewarded CycloneDX 1.5 used by
// Dependency-Track, OSV-Scanner, syft, and the Capa compiler's
// own --cyclonedx output.
//
// What this demo shows:
//
// - The same patterns as the SPDX parser (typed Capa structs,
//   ?-chaining on Result, pattern matching on JsonValue), now
//   applied to a different JSON shape. The SBOM-reading helper
//   set (`field`, `optional_field`, `as_*_or_err`,
//   `string_field_or`, `bool_field_or`) is shared in spirit but
//   re-defined locally so each example stays self-contained.
// - The same `capability SbomReader` boundary, demonstrating
//   that one capability can serve every supply-chain format.
// - The CycloneDX-specific shape: a top-level `components[]`
//   array (vs SPDX's `packages[]`), a flat `dependencies[]`
//   array of (ref, dependsOn[]) edges (vs SPDX's typed
//   `relationships[]`), and component hashes as
//   `{alg, content}` pairs (vs SPDX's `{algorithm,
//   checksumValue}`).
//
// This parser now covers every optional array CycloneDX 1.5
// publishes in the JSON schema; the only deferred shape is the
// XML alternative serialisation, tracked in TODO.md. Signature
// verification (the crypto part) is intentionally not in scope;
// this parser captures the JSF metadata only.
// `externalReferences[]` is parsed only on components; the spec
// also allows it on metadata.component, services[],
// vulnerabilities[], and the document root, but extending the
// parser to those locations is mechanical.

capability SbomReader
    fun read(self, source: String) -> Result<String, String>

type CdxHash {
    algorithm: String,
    content: String
}

type CdxLicense {
    id: String,
    name: String,
    expression: String
}

type CdxIdentityMethod {
    technique: String,
    confidence: Float,
    value: String
}

type CdxIdentity {
    field: String,
    confidence: Float,
    methods: List<CdxIdentityMethod>
}

type CdxOccurrence {
    bom_ref: String,
    location: String
}

type CdxCopyright {
    text: String
}

// Evidence sub-block on a component: how the component was
// identified and where its source / artefact was found.
type CdxEvidence {
    has_identity: Bool,
    identity: CdxIdentity,
    occurrences: List<CdxOccurrence>,
    copyright: List<CdxCopyright>
}

// CycloneDX 1.5 externalReferences entry: a URL pointing at a
// resource related to the component (homepage, vcs, advisory
// feed, release notes, attestation, ...). Only the per-component
// location is parsed today; the spec also allows the array on
// metadata.component, services[], vulnerabilities[], and the
// document root. Extending to those is mechanical.
type CdxExternalRef {
    kind: String,
    url: String,
    comment: String,
    hashes: List<CdxHash>
}

type CdxComponent {
    bom_ref: String,
    kind: String,
    name: String,
    version: String,
    purl: String,
    hashes: List<CdxHash>,
    licenses: List<CdxLicense>,
    has_evidence: Bool,
    evidence: CdxEvidence,
    external_references: List<CdxExternalRef>
}

type CdxDependency {
    ref: String,
    depends_on: List<String>
}

type CdxSource {
    name: String,
    url: String
}

type CdxRating {
    severity: String,
    score: Float,
    method: String
}

type CdxAffects {
    ref: String
}

// VEX analysis statement attached to a vulnerability.
type CdxAnalysis {
    state: String,
    justification: String,
    detail: String
}

type CdxVulnerability {
    bom_ref: String,
    id: String,
    source: CdxSource,
    ratings: List<CdxRating>,
    cwes: List<Int>,
    description: String,
    recommendation: String,
    published: String,
    updated: String,
    affects: List<CdxAffects>,
    analysis: CdxAnalysis
}

// Service-record types. `provider.url` is an array in 1.5 (unlike
// `CdxSource.url` which is a single string on vulnerabilities).
// Nested `services[]` inside a service is allowed by the spec but
// nobody uses it; skipped here.
type CdxProvider {
    name: String,
    urls: List<String>
}

type CdxDataClassification {
    classification: String,
    flow: String
}

type CdxService {
    bom_ref: String,
    provider: CdxProvider,
    group: String,
    name: String,
    version: String,
    description: String,
    endpoints: List<String>,
    authenticated: Bool,
    x_trust_boundary: Bool,
    data: List<CdxDataClassification>
}

type CdxMetadata {
    timestamp: String,
    tool_names: List<String>,
    main_component_ref: String,
    main_component_name: String
}

// CycloneDX 1.5 JSF (JSON Signature Format) header. Only the
// single-signer flat shape is supported; nested publicKey,
// certificatePath, and chain[] / signers[] are out of scope.
// This parser captures the fields; no cryptographic
// verification is performed.
type CdxSignature {
    algorithm: String,
    key_id: String,
    value: String
}

// CycloneDX 1.5 compositions[]: declarations of how complete
// the BOM's view of the world is for a given subset of
// components / dependencies / vulnerabilities. Useful when an
// SBOM is being built incrementally and the auditor needs to
// know what's deliberately omitted.
type CdxComposition {
    bom_ref: String,
    aggregate: String,
    assemblies: List<String>,
    dependencies: List<String>,
    vulnerabilities: List<String>
}

type CdxDocument {
    bom_format: String,
    spec_version: String,
    serial_number: String,
    version: Int,
    metadata: CdxMetadata,
    components: List<CdxComponent>,
    dependencies: List<CdxDependency>,
    vulnerabilities: List<CdxVulnerability>,
    services: List<CdxService>,
    has_signature: Bool,
    signature: CdxSignature,
    compositions: List<CdxComposition>
}

// ---- typed-extraction helpers ----

fun as_object_or_err(j: JsonValue, context: String) -> Result<Map<String, JsonValue>, String>
    return match j.as_object()
        None -> Err("expected object for ${context}")
        Some(m) -> Ok(m)

fun as_array_or_err(j: JsonValue, context: String) -> Result<List<JsonValue>, String>
    return match j.as_array()
        None -> Err("expected array for ${context}")
        Some(xs) -> Ok(xs)

fun as_string_or_err(j: JsonValue, context: String) -> Result<String, String>
    return match j.as_string()
        None -> Err("expected string for ${context}")
        Some(s) -> Ok(s)

fun as_num_or_err(j: JsonValue, context: String) -> Result<Float, String>
    return match j.as_num()
        None -> Err("expected number for ${context}")
        Some(n) -> Ok(n)

fun field(j: JsonValue, name: String) -> Result<JsonValue, String>
    let obj = as_object_or_err(j, "lookup '${name}'")?
    return match obj.get(name)
        None -> Err("missing required field '${name}'")
        Some(v) -> Ok(v)

fun optional_field(j: JsonValue, name: String) -> Option<JsonValue>
    return match j.as_object()
        None -> None
        Some(m) -> m.get(name)

fun string_field_or(j: JsonValue, name: String, fallback: String) -> String
    return match optional_field(j, name)
        None -> fallback
        Some(v) -> match v.as_string()
            None -> fallback
            Some(s) -> s

// ---- per-record parsers ----

fun parse_hash(j: JsonValue) -> Result<CdxHash, String>
    return Ok(CdxHash {
        algorithm: as_string_or_err(field(j, "alg")?, "Hash.alg")?,
        content: as_string_or_err(field(j, "content")?, "Hash.content")?
    })

fun parse_hashes(j: JsonValue) -> Result<List<CdxHash>, String>
    let xs = as_array_or_err(j, "Component.hashes")?
    let result: List<CdxHash> = []
    for x in xs
        result.push(parse_hash(x)?)
    return Ok(result)

// CycloneDX licenses are an OR-list of {license: {id|name}} or
// {expression: <SPDX-expression>}. We flatten each entry into
// the same CdxLicense shape; unused fields stay as empty strings.
fun parse_license_entry(j: JsonValue) -> Result<CdxLicense, String>
    let obj = as_object_or_err(j, "licenses[i]")?
    match obj.get("expression")
        Some(v) ->
            let expr = as_string_or_err(v, "licenses[i].expression")?
            return Ok(CdxLicense { id: "", name: "", expression: expr })
        None ->
            ()
    let inner = obj.get("license")
    match inner
        None ->
            return Err("license entry must have 'license' or 'expression'")
        Some(lv) ->
            let lic_obj = as_object_or_err(lv, "licenses[i].license")?
            let id = match lic_obj.get("id")
                None -> ""
                Some(v) -> match v.as_string()
                    None -> ""
                    Some(s) -> s
            let name = match lic_obj.get("name")
                None -> ""
                Some(v) -> match v.as_string()
                    None -> ""
                    Some(s) -> s
            return Ok(CdxLicense { id: id, name: name, expression: "" })

fun parse_licenses(j: JsonValue) -> Result<List<CdxLicense>, String>
    let xs = as_array_or_err(j, "Component.licenses")?
    let result: List<CdxLicense> = []
    for x in xs
        result.push(parse_license_entry(x)?)
    return Ok(result)

// Evidence sub-block parsers. `evidence.identity` is a single
// object in CycloneDX 1.5 (the 1.6 array form is out of scope).
// `licenses` + `callstack` under evidence are skipped too.

fun parse_identity_method(j: JsonValue) -> Result<CdxIdentityMethod, String>
    let confidence = match optional_field(j, "confidence")
        None -> 0.0
        Some(v) -> as_num_or_err(v, "Identity.method.confidence")?
    return Ok(CdxIdentityMethod {
        technique: string_field_or(j, "technique", ""),
        confidence: confidence,
        value: string_field_or(j, "value", "")
    })

fun parse_identity(j: JsonValue) -> Result<CdxIdentity, String>
    let confidence = match optional_field(j, "confidence")
        None -> 0.0
        Some(v) -> as_num_or_err(v, "Identity.confidence")?
    let methods: List<CdxIdentityMethod> = []
    match optional_field(j, "methods")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "Identity.methods")?
            for x in xs
                methods.push(parse_identity_method(x)?)
    return Ok(CdxIdentity {
        field: string_field_or(j, "field", ""),
        confidence: confidence,
        methods: methods
    })

fun parse_occurrence(j: JsonValue) -> Result<CdxOccurrence, String>
    return Ok(CdxOccurrence {
        bom_ref: string_field_or(j, "bom-ref", ""),
        location: as_string_or_err(field(j, "location")?, "Occurrence.location")?
    })

fun parse_copyright_entry(j: JsonValue) -> Result<CdxCopyright, String>
    return Ok(CdxCopyright {
        text: as_string_or_err(field(j, "text")?, "Copyright.text")?
    })

fun parse_evidence(j: JsonValue) -> Result<CdxEvidence, String>
    var has_identity = false
    var identity = CdxIdentity { field: "", confidence: 0.0, methods: [] }
    match optional_field(j, "identity")
        None ->
            ()
        Some(v) ->
            has_identity = true
            identity = parse_identity(v)?

    let occurrences: List<CdxOccurrence> = []
    match optional_field(j, "occurrences")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "Evidence.occurrences")?
            for x in xs
                occurrences.push(parse_occurrence(x)?)

    let copyright: List<CdxCopyright> = []
    match optional_field(j, "copyright")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "Evidence.copyright")?
            for x in xs
                copyright.push(parse_copyright_entry(x)?)

    return Ok(CdxEvidence {
        has_identity: has_identity,
        identity: identity,
        occurrences: occurrences,
        copyright: copyright
    })

fun parse_external_ref(j: JsonValue) -> Result<CdxExternalRef, String>
    let hashes: List<CdxHash> = []
    match optional_field(j, "hashes")
        None ->
            ()
        Some(v) ->
            let parsed = parse_hashes(v)?
            for h in parsed
                hashes.push(h)

    return Ok(CdxExternalRef {
        kind: as_string_or_err(field(j, "type")?, "ExternalRef.type")?,
        url: as_string_or_err(field(j, "url")?, "ExternalRef.url")?,
        comment: string_field_or(j, "comment", ""),
        hashes: hashes
    })

fun parse_external_refs(items: List<JsonValue>) -> Result<List<CdxExternalRef>, String>
    let result: List<CdxExternalRef> = []
    for item in items
        result.push(parse_external_ref(item)?)
    return Ok(result)

fun parse_component(j: JsonValue) -> Result<CdxComponent, String>
    let hashes: List<CdxHash> = []
    match optional_field(j, "hashes")
        None ->
            ()
        Some(v) ->
            let parsed = parse_hashes(v)?
            for h in parsed
                hashes.push(h)

    let licenses: List<CdxLicense> = []
    match optional_field(j, "licenses")
        None ->
            ()
        Some(v) ->
            let parsed = parse_licenses(v)?
            for l in parsed
                licenses.push(l)

    var has_evidence = false
    var evidence = CdxEvidence {
        has_identity: false,
        identity: CdxIdentity { field: "", confidence: 0.0, methods: [] },
        occurrences: [],
        copyright: []
    }
    match optional_field(j, "evidence")
        None ->
            ()
        Some(v) ->
            has_evidence = true
            evidence = parse_evidence(v)?

    let external_references: List<CdxExternalRef> = []
    match optional_field(j, "externalReferences")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "Component.externalReferences")?
            let parsed = parse_external_refs(xs)?
            for er in parsed
                external_references.push(er)

    return Ok(CdxComponent {
        bom_ref: string_field_or(j, "bom-ref", ""),
        kind: as_string_or_err(field(j, "type")?, "Component.type")?,
        name: as_string_or_err(field(j, "name")?, "Component.name")?,
        version: string_field_or(j, "version", ""),
        purl: string_field_or(j, "purl", ""),
        hashes: hashes,
        licenses: licenses,
        has_evidence: has_evidence,
        evidence: evidence,
        external_references: external_references
    })

fun parse_dependency(j: JsonValue) -> Result<CdxDependency, String>
    let ref = as_string_or_err(field(j, "ref")?, "Dependency.ref")?
    let depends: List<String> = []
    match optional_field(j, "dependsOn")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "Dependency.dependsOn")?
            for x in xs
                depends.push(as_string_or_err(x, "Dependency.dependsOn[i]")?)
    return Ok(CdxDependency { ref: ref, depends_on: depends })

// Vulnerability-record parsers. Every nested field is optional in
// CycloneDX 1.5 except `id`; absent values fall back to empty
// strings / empty lists / zero-valued structs.

fun parse_source(j: JsonValue) -> Result<CdxSource, String>
    return Ok(CdxSource {
        name: string_field_or(j, "name", ""),
        url: string_field_or(j, "url", "")
    })

fun parse_rating(j: JsonValue) -> Result<CdxRating, String>
    let score = match optional_field(j, "score")
        None -> 0.0
        Some(v) -> as_num_or_err(v, "Rating.score")?
    return Ok(CdxRating {
        severity: string_field_or(j, "severity", ""),
        score: score,
        method: string_field_or(j, "method", "")
    })

fun parse_affects_entry(j: JsonValue) -> Result<CdxAffects, String>
    return Ok(CdxAffects {
        ref: as_string_or_err(field(j, "ref")?, "Affects.ref")?
    })

fun parse_analysis(j: JsonValue) -> Result<CdxAnalysis, String>
    return Ok(CdxAnalysis {
        state: string_field_or(j, "state", ""),
        justification: string_field_or(j, "justification", ""),
        detail: string_field_or(j, "detail", "")
    })

fun parse_vulnerability(j: JsonValue) -> Result<CdxVulnerability, String>
    let source = match optional_field(j, "source")
        None -> CdxSource { name: "", url: "" }
        Some(v) -> parse_source(v)?

    let ratings: List<CdxRating> = []
    match optional_field(j, "ratings")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "Vulnerability.ratings")?
            for x in xs
                ratings.push(parse_rating(x)?)

    let cwes: List<Int> = []
    match optional_field(j, "cwes")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "Vulnerability.cwes")?
            for x in xs
                let n = as_num_or_err(x, "Vulnerability.cwes[i]")?
                cwes.push(to_int(n))

    let affects: List<CdxAffects> = []
    match optional_field(j, "affects")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "Vulnerability.affects")?
            for x in xs
                affects.push(parse_affects_entry(x)?)

    let analysis = match optional_field(j, "analysis")
        None -> CdxAnalysis { state: "", justification: "", detail: "" }
        Some(v) -> parse_analysis(v)?

    return Ok(CdxVulnerability {
        bom_ref: string_field_or(j, "bom-ref", ""),
        id: as_string_or_err(field(j, "id")?, "Vulnerability.id")?,
        source: source,
        ratings: ratings,
        cwes: cwes,
        description: string_field_or(j, "description", ""),
        recommendation: string_field_or(j, "recommendation", ""),
        published: string_field_or(j, "published", ""),
        updated: string_field_or(j, "updated", ""),
        affects: affects,
        analysis: analysis
    })

// Service-record parsers. Every nested field is optional; absent
// values fall back to empty strings / empty lists / zero-valued
// structs. Nested `services[]` inside a service is skipped.

fun bool_field_or(j: JsonValue, name: String, fallback: Bool) -> Bool
    return match optional_field(j, name)
        None -> fallback
        Some(v) -> match v.as_bool()
            None -> fallback
            Some(b) -> b

fun parse_provider(j: JsonValue) -> Result<CdxProvider, String>
    let urls: List<String> = []
    match optional_field(j, "url")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "Provider.url")?
            for x in xs
                urls.push(as_string_or_err(x, "Provider.url[i]")?)
    return Ok(CdxProvider {
        name: string_field_or(j, "name", ""),
        urls: urls
    })

fun parse_data_classification(j: JsonValue) -> Result<CdxDataClassification, String>
    return Ok(CdxDataClassification {
        classification: string_field_or(j, "classification", ""),
        flow: string_field_or(j, "flow", "")
    })

fun parse_service(j: JsonValue) -> Result<CdxService, String>
    let provider = match optional_field(j, "provider")
        None -> CdxProvider { name: "", urls: [] }
        Some(v) -> parse_provider(v)?

    let endpoints: List<String> = []
    match optional_field(j, "endpoints")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "Service.endpoints")?
            for x in xs
                endpoints.push(as_string_or_err(x, "Service.endpoints[i]")?)

    let data: List<CdxDataClassification> = []
    match optional_field(j, "data")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "Service.data")?
            for x in xs
                data.push(parse_data_classification(x)?)

    return Ok(CdxService {
        bom_ref: string_field_or(j, "bom-ref", ""),
        provider: provider,
        group: string_field_or(j, "group", ""),
        name: string_field_or(j, "name", ""),
        version: string_field_or(j, "version", ""),
        description: string_field_or(j, "description", ""),
        endpoints: endpoints,
        authenticated: bool_field_or(j, "authenticated", false),
        x_trust_boundary: bool_field_or(j, "x-trust-boundary", false),
        data: data
    })

// Signature parser. Captures the flat single-signer JSF shape
// (algorithm + keyId + value); nested publicKey / certificatePath
// / chain[] / signers[] are intentionally out of scope, as is any
// actual cryptographic verification.
fun parse_signature(j: JsonValue) -> Result<CdxSignature, String>
    return Ok(CdxSignature {
        algorithm: string_field_or(j, "algorithm", ""),
        key_id: string_field_or(j, "keyId", ""),
        value: string_field_or(j, "value", "")
    })

// Composition parser. All three ref-bearing arrays are optional;
// `aggregate` is the only required field. The validator handles
// enum + cross-array referential-integrity checks.
fun parse_composition(j: JsonValue) -> Result<CdxComposition, String>
    let assemblies: List<String> = []
    match optional_field(j, "assemblies")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "Composition.assemblies")?
            for x in xs
                assemblies.push(as_string_or_err(x, "Composition.assemblies[i]")?)

    let dependencies: List<String> = []
    match optional_field(j, "dependencies")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "Composition.dependencies")?
            for x in xs
                dependencies.push(as_string_or_err(x, "Composition.dependencies[i]")?)

    let vulnerabilities: List<String> = []
    match optional_field(j, "vulnerabilities")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "Composition.vulnerabilities")?
            for x in xs
                vulnerabilities.push(as_string_or_err(x, "Composition.vulnerabilities[i]")?)

    return Ok(CdxComposition {
        bom_ref: string_field_or(j, "bom-ref", ""),
        aggregate: as_string_or_err(field(j, "aggregate")?, "Composition.aggregate")?,
        assemblies: assemblies,
        dependencies: dependencies,
        vulnerabilities: vulnerabilities
    })

fun extract_tool_names(tools_j: JsonValue) -> Result<List<String>, String>
    // CycloneDX 1.5 supports both the modern `tools.components[]`
    // shape (each entry a Component object) and the legacy flat
    // `tools[]` array. We handle both.
    let names: List<String> = []
    match tools_j.as_object()
        Some(tobj) ->
            match tobj.get("components")
                Some(comps) ->
                    let xs = as_array_or_err(comps, "metadata.tools.components")?
                    for x in xs
                        names.push(string_field_or(x, "name", ""))
                None ->
                    ()
        None ->
            match tools_j.as_array()
                Some(xs) ->
                    for x in xs
                        names.push(string_field_or(x, "name", ""))
                None ->
                    ()
    return Ok(names)

fun parse_metadata(j: JsonValue) -> Result<CdxMetadata, String>
    // metadata is itself an optional top-level field; if absent
    // we return empty defaults for every nested field. If present
    // we extract its sub-fields one by one. Avoiding a JNull
    // placeholder keeps the type discipline clean.
    let ts = ""
    let tool_names: List<String> = []
    let main_ref = ""
    let main_name = ""

    match optional_field(j, "metadata")
        None ->
            return Ok(CdxMetadata {
                timestamp: ts,
                tool_names: tool_names,
                main_component_ref: main_ref,
                main_component_name: main_name
            })
        Some(md) ->
            let ts2 = string_field_or(md, "timestamp", "")
            match optional_field(md, "tools")
                None ->
                    ()
                Some(tj) ->
                    let parsed = extract_tool_names(tj)?
                    for n in parsed
                        tool_names.push(n)
            let ref2 = match optional_field(md, "component")
                None -> ""
                Some(c) -> string_field_or(c, "bom-ref", "")
            let name2 = match optional_field(md, "component")
                None -> ""
                Some(c) -> string_field_or(c, "name", "")
            return Ok(CdxMetadata {
                timestamp: ts2,
                tool_names: tool_names,
                main_component_ref: ref2,
                main_component_name: name2
            })

fun parse_document(j: JsonValue) -> Result<CdxDocument, String>
    let bom_format = as_string_or_err(field(j, "bomFormat")?, "bomFormat")?
    if bom_format != "CycloneDX"
        return Err("expected bomFormat 'CycloneDX', got '${bom_format}'")
    let spec_version = as_string_or_err(field(j, "specVersion")?, "specVersion")?
    let serial = string_field_or(j, "serialNumber", "")
    let version_num = as_num_or_err(field(j, "version")?, "version")?

    let components: List<CdxComponent> = []
    match optional_field(j, "components")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "components")?
            for x in xs
                components.push(parse_component(x)?)

    let dependencies: List<CdxDependency> = []
    match optional_field(j, "dependencies")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "dependencies")?
            for x in xs
                dependencies.push(parse_dependency(x)?)

    let vulnerabilities: List<CdxVulnerability> = []
    match optional_field(j, "vulnerabilities")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "vulnerabilities")?
            for x in xs
                vulnerabilities.push(parse_vulnerability(x)?)

    let services: List<CdxService> = []
    match optional_field(j, "services")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "services")?
            for x in xs
                services.push(parse_service(x)?)

    var has_signature = false
    var signature = CdxSignature { algorithm: "", key_id: "", value: "" }
    match optional_field(j, "signature")
        None ->
            ()
        Some(v) ->
            has_signature = true
            signature = parse_signature(v)?

    let compositions: List<CdxComposition> = []
    match optional_field(j, "compositions")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "compositions")?
            for x in xs
                compositions.push(parse_composition(x)?)

    let metadata = parse_metadata(j)?

    return Ok(CdxDocument {
        bom_format: bom_format,
        spec_version: spec_version,
        serial_number: serial,
        version: to_int(version_num),
        metadata: metadata,
        components: components,
        dependencies: dependencies,
        vulnerabilities: vulnerabilities,
        services: services,
        has_signature: has_signature,
        signature: signature,
        compositions: compositions
    })

fun parse_cyclonedx(json_text: String) -> Result<CdxDocument, String>
    return match parse_json(json_text)
        Err(msg) -> Err("JSON parse error: ${msg}")
        Ok(j) -> parse_document(j)

// ---- validation: referential integrity ----
//
// A CycloneDX document is well-formed only if every Dependency
// edge (both the parent `ref` and every entry in `dependsOn`)
// points at a bom-ref that the document actually defines. The
// metadata.component bom-ref is also a valid target. Dangling
// references are the most common failure mode in real-world
// SBOMs and the thing a CRA auditor needs to flag.
//
// Mirrors `validate_spdx` in spdx_parser.capa: same role, same
// shape of output (a List<String> of human-readable violations,
// empty list = the document is internally consistent).

fun collect_bom_refs(doc: CdxDocument) -> Set<String>
    let refs: Set<String> = new_set()
    if doc.metadata.main_component_ref != ""
        refs.add(doc.metadata.main_component_ref)
    for c in doc.components
        if c.bom_ref != ""
            refs.add(c.bom_ref)
    for s in doc.services
        if s.bom_ref != ""
            refs.add(s.bom_ref)
    return refs

// Severity strings the CycloneDX 1.5 schema allows on a rating.
fun is_valid_severity(s: String) -> Bool
    if s == "critical"
        return true
    if s == "high"
        return true
    if s == "medium"
        return true
    if s == "low"
        return true
    if s == "info"
        return true
    if s == "none"
        return true
    if s == "unknown"
        return true
    return false

// VEX analysis-state enum from CycloneDX 1.5.
fun is_valid_analysis_state(s: String) -> Bool
    if s == "resolved"
        return true
    if s == "resolved_with_pedigree"
        return true
    if s == "exploitable"
        return true
    if s == "in_triage"
        return true
    if s == "false_positive"
        return true
    if s == "not_affected"
        return true
    return false

// data[].flow enum from CycloneDX 1.5.
fun is_valid_data_flow(s: String) -> Bool
    if s == "inbound"
        return true
    if s == "outbound"
        return true
    if s == "bi-directional"
        return true
    if s == "unknown"
        return true
    return false

