        return true
    if alg == "RS384"
        return true
    if alg == "RS512"
        return true
    if alg == "PS256"
        return true
    if alg == "PS384"
        return true
    if alg == "PS512"
        return true
    if alg == "ES256"
        return true
    if alg == "ES384"
        return true
    if alg == "ES512"
        return true
    if alg == "Ed25519"
        return true
    if alg == "Ed448"
        return true
    if alg == "HS256"
        return true
    if alg == "HS384"
        return true
    if alg == "HS512"
        return true
    return false

// compositions[].aggregate enum from CycloneDX 1.5.
fun is_valid_aggregate(a: String) -> Bool
    if a == "complete"
        return true
    if a == "incomplete"
        return true
    if a == "incomplete_first_party_only"
        return true
    if a == "incomplete_first_party_proprietary_only"
