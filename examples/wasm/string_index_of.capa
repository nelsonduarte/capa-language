// String.index_of parity (D3 slice 4, 2026-05). Covers a normal
// hit, a miss, a needle longer than the receiver, and the empty
// needle (matches Python's ``str.find("")`` which returns 0 for
// any receiver). The return shape is ``Option<Int>`` -- the legacy
// ``-1`` sentinel is gone.

fun main(stdio: Stdio)
    let s = "hello world"
    match s.index_of("world")
        Some(i) -> stdio.println("hit at ${i}")
        None    -> stdio.println("miss")
    match s.index_of("xyz")
        Some(i) -> stdio.println("hit at ${i}")
        None    -> stdio.println("miss")
    match "ab".index_of("abcdef")
        Some(i) -> stdio.println("hit at ${i}")
        None    -> stdio.println("miss")
    match s.index_of("")
        Some(i) -> stdio.println("empty at ${i}")
        None    -> stdio.println("empty miss")
    match "".index_of("")
        Some(i) -> stdio.println("empty/empty at ${i}")
        None    -> stdio.println("empty/empty miss")
    match s.index_of("hello")
        Some(i) -> stdio.println("prefix at ${i}")
        None    -> stdio.println("prefix miss")
    // Multibyte: index_of returns a code-point offset, not a byte
    // offset (slice 17). The emoji is one code point but four UTF-8
    // bytes, so the byte offset of "b" is 5 while the code-point
    // offset is 2. Both backends must agree on 2.
    let m = "a\u{1F600}b"
    match m.index_of("b")
        Some(i) -> stdio.println("mb b at ${i}")
        None    -> stdio.println("mb b miss")
    // Two-byte (e) and three-byte (CJK) code points before the hit.
    let m2 = "café\u{4E2D}x"
    match m2.index_of("x")
        Some(i) -> stdio.println("mb x at ${i}")
        None    -> stdio.println("mb x miss")
    // Needle that itself is multibyte, with a multibyte prefix.
    match m2.index_of("\u{4E2D}")
        Some(i) -> stdio.println("mb needle at ${i}")
        None    -> stdio.println("mb needle miss")
