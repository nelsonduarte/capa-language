// Net.get returns Result<String, IoError>. The Python backend and the
// host bridge share the one Net object.
//
// STALE PREMISE, kept as a record: this example was written when a
// ``file://`` URL read the local file through Net. Since 1.20.0 Net
// speaks http / https only, so ``net.get("file:///...")`` below returns
// Err("Net capability does not permit scheme 'file': a Net capability
// speaks http/https only") on --run, --wasm --run and
// --wasm --component --run alike, and the Err arm prints its "BUG:"
// line to stderr. Stdout ("wrote fixture") is still identical across
// the backends, which is all the parity tests compare; they do not
// exercise a successful Net.get. The fixture path lives under ``/tmp/``
// (the conventional ``Fs`` write target reused by ``fs_demo.capa``).

fun main(stdio: Stdio, fs: Fs, net: Net)
    let path = "/tmp/capa_wasm_net_get_fixture.txt"
    let body = "hello from a fixture file"
    match fs.write(path, body)
        Ok(_) -> stdio.println("wrote fixture")
        Err(_) -> stdio.eprintln("BUG: could not write fixture")

    match net.get("file:///tmp/capa_wasm_net_get_fixture.txt")
        Ok(text) -> stdio.println("got: ${text}")
        Err(_) -> stdio.eprintln("BUG: file:// read failed")
