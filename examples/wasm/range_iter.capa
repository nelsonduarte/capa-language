// Range iteration: `for i in a..b` (exclusive) and `for j in
// a..=b` (inclusive). Pre-slice-5 (2026-05) the Wasm emitter
// rejected the Range type; MakeRange allocates a 24-byte heap
// record and the for-iter fast path reads start / end /
// inclusive directly without materialising the integer
// sequence.

fun show(stdio: Stdio, label: String, n: Int)
    stdio.println("${label}: ${n}")

fun main(stdio: Stdio)
    var sum_excl = 0
    for i in 0..5
        sum_excl = sum_excl + i
    show(stdio, "0..5 sum", sum_excl)

    var sum_incl = 0
    for j in 1..=5
        sum_incl = sum_incl + j
    show(stdio, "1..=5 sum", sum_incl)

    // Non-literal bounds.
    let lo = 2
    let hi = 8
    var sum_var = 0
    for k in lo..hi
        sum_var = sum_var + k
    show(stdio, "lo..hi sum", sum_var)

    // Empty range produces zero iterations on both backends.
    var entered = 0
    for n in 7..7
        entered = entered + 1
    show(stdio, "7..7 iters", entered)

    // Nested range loops: outer 1..=3, inner 0..outer.
    var total_pairs = 0
    for o in 1..=3
        for p in 0..o
            total_pairs = total_pairs + 1
    show(stdio, "nested pairs", total_pairs)
