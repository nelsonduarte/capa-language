// Positive-case parity for the five safety traps closed by the
// 2026-05 security audit. Each section pairs valid inputs whose
// observable output is byte-identical between the Python and Wasm
// backends; the negative cases (overflow, shift out of range, etc.)
// live in tests/test_ir_wasm.py and tests/test_transpiler.py, where
// each backend can assert its trap / raise fires at the same input.
//
// Both backends now fail loud at the same point on the negative
// cases; this file pins that the loud-failure check did NOT regress
// the well-behaved happy path.

fun main(stdio: Stdio)
    // Fix C3: shift count in [0, 63] still works.
    stdio.println("${5 << 3}")      // 40
    stdio.println("${1024 >> 4}")   // 64

    // Fix C2: Int +/-/* near (but inside) the i64 window.
    let big = 1_000_000 * 1_000_000           // 1e12
    stdio.println("${big}")                    // 1000000000000
    let s = 2_000_000_000 + 2_000_000_000      // 4e9
    stdio.println("${s}")                      // 4000000000
    stdio.println("${100 - 200}")              // -100

    // Fix C6: Float % with a non-zero divisor stays loud-free.
    stdio.println("${7.5 % 3.0}")              // 1.5
    stdio.println("${-7.5 % 3.0}")             // 1.5 (Python's floored modulo)

    // Fix C5: parse_int on a value inside the i64 window still parses.
    match parse_int("9223372036854775807")
        Some(n) -> stdio.println("${n}")        // 9223372036854775807
        None -> stdio.println("parse failed")
    match parse_int("not a number")
        Some(n) -> stdio.println("${n}")
        None -> stdio.println("None")           // None
