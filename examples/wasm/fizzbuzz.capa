// FizzBuzz in Wasm: exercises while loops, conditionals,
// arithmetic, and string interpolation through the capa:host/stdio
// import. The capability flows in via main's `stdio` param, which
// the wasm signature drops because methods are imported by name.

fun is_div(n: Int, by: Int) -> Bool
    return n % by == 0

fun main(stdio: Stdio)
    var i = 1
    while i <= 15
        if is_div(i, 15)
            stdio.println("FizzBuzz")
        elif is_div(i, 3)
            stdio.println("Fizz")
        elif is_div(i, 5)
            stdio.println("Buzz")
        else
            stdio.println("${i}")
        i = i + 1
