// SPDX 2.3 JSON parser, demonstration of Capa applied to real SBOM
// data. Parses the core fields of an SPDX 2.3 document (the SPDX
// JSON Schema published by the Linux Foundation): document
// metadata, packages, file checksums, and relationships. The
// parser builds a typed Capa AST from the loosely-typed
// JsonValue, surfacing structural errors as Result<_, String>.
//
// What this demo shows:
//
// - A user-defined capability (capability SbomReader) representing
//   the authority to read and verify SBOM metadata. It is method-
//   less; its role is to make the trust boundary visible in every
//   function that touches an SBOM.
// - Pattern matching on JsonValue variants (JObj, JArr, JStr...)
//   to traverse a real-world JSON tree.
// - Result/Option chaining via the `?` operator, so every parser
//   function reads top-down without the noise of manual
//   match-on-error.
// - Building typed Capa structs from the unstructured tree.
//
// Scope limits: only the SPDX fields needed to demonstrate the
// approach. SPDX has dozens of optional fields (external
// document refs); extending this to the full spec is
// mechanical.

capability SbomReader
    fun read(self, source: String) -> Result<String, String>

type Checksum {
    algorithm: String,
    value: String
}

type Package {
    spdx_id: String,
    name: String,
    version: String,
    download_location: String,
    license_concluded: String,
    license_declared: String,
    files_analyzed: Bool,
    checksums: List<Checksum>,
    annotations: List<Annotation>
}

type Relationship {
    source: String,
    kind: String,
    target: String
}

type CreationInfo {
    created: String,
    creators: List<String>
}

// SPDX 2.3 annotation: machine-readable comment attached to a
// document or a package. `type` is a Capa keyword, so the
// annotationType field is renamed `kind` (mirrors Relationship).
type Annotation {
    annotator: String,
    date: String,
    kind: String,
    comment: String
}

// SPDX 2.3 hasExtractedLicensingInfo: a license definition not
// in the SPDX License List (vendor-specific or custom). The
// licenseId must start with "LicenseRef-" and extractedText
// carries the verbatim license body.
type ExtractedLicense {
    license_id: String,
    extracted_text: String,
    name: String,
    see_alsos: List<String>,
    comment: String
}

// SPDX 2.3 snippet: a sub-region of a file with its own
// license / copyright provenance, addressed by a range over
// the parent file.
type Range {
    start_offset: Int,
    end_offset: Int,
    reference: String
}

type Snippet {
    spdx_id: String,
    snippet_from_file: String,
    ranges: List<Range>,
    license_concluded: String,
    license_info_in_snippets: List<String>,
    name: String,
    comment: String,
    copyright_text: String
}

type SpdxDocument {
    spdx_version: String,
    data_license: String,
    spdx_id: String,
    name: String,
    document_namespace: String,
    creation_info: CreationInfo,
    packages: List<Package>,
    relationships: List<Relationship>,
    annotations: List<Annotation>,
    extracted_licenses: List<ExtractedLicense>,
    snippets: List<Snippet>
}

// ---- typed-extraction helpers ----
//
// All helpers return Result, so the `?` operator chains them
// cleanly in every parser function below. The convention is
// "<extractor>_or_err" returns the inner value; "<field>" goes
// through an object lookup; "_or" supplies a fallback for
// optional fields.

fun as_object_or_err(j: JsonValue, context: String) -> Result<Map<String, JsonValue>, String>
    return match j.as_object()
        None -> Err("expected object for ${context}")
        Some(m) -> Ok(m)

fun as_array_or_err(j: JsonValue, context: String) -> Result<List<JsonValue>, String>
    return match j.as_array()
        None -> Err("expected array for ${context}")
        Some(xs) -> Ok(xs)

fun as_string_or_err(j: JsonValue, context: String) -> Result<String, String>
    return match j.as_string()
        None -> Err("expected string for ${context}")
        Some(s) -> Ok(s)

// Look up a required field on a JSON object value.
fun field(j: JsonValue, name: String) -> Result<JsonValue, String>
    let obj = as_object_or_err(j, "lookup '${name}'")?
    return match obj.get(name)
        None -> Err("missing required field '${name}'")
        Some(v) -> Ok(v)

// Same as field, but returns None_ instead of Err on missing field
// or non-object receiver.
fun optional_field(j: JsonValue, name: String) -> Option<JsonValue>
    return match j.as_object()
        None -> None
        Some(m) -> m.get(name)

// Read an optional string field, falling back to a default.
fun string_field_or(j: JsonValue, name: String, fallback: String) -> String
    return match optional_field(j, name)
        None -> fallback
        Some(v) -> match v.as_string()
            None -> fallback
            Some(s) -> s

// Read an optional bool field, falling back to a default.
fun bool_field_or(j: JsonValue, name: String, fallback: Bool) -> Bool
    return match optional_field(j, name)
        None -> fallback
        Some(v) -> match v.as_bool()
            None -> fallback
            Some(b) -> b

// ---- per-record parsers ----

fun parse_checksum(j: JsonValue) -> Result<Checksum, String>
    return Ok(Checksum {
        algorithm: as_string_or_err(field(j, "algorithm")?, "Checksum.algorithm")?,
        value: as_string_or_err(field(j, "checksumValue")?, "Checksum.checksumValue")?
    })

fun parse_checksums(items: List<JsonValue>) -> Result<List<Checksum>, String>
    let result: List<Checksum> = []
    for item in items
        result.push(parse_checksum(item)?)
    return Ok(result)

fun parse_annotation(j: JsonValue) -> Result<Annotation, String>
    return Ok(Annotation {
        annotator: as_string_or_err(field(j, "annotator")?, "Annotation.annotator")?,
        date: as_string_or_err(field(j, "annotationDate")?, "Annotation.annotationDate")?,
        kind: as_string_or_err(field(j, "annotationType")?, "Annotation.annotationType")?,
        comment: as_string_or_err(field(j, "comment")?, "Annotation.comment")?
    })

fun parse_annotations(items: List<JsonValue>) -> Result<List<Annotation>, String>
    let result: List<Annotation> = []
    for item in items
        result.push(parse_annotation(item)?)
    return Ok(result)

fun parse_extracted_license(j: JsonValue) -> Result<ExtractedLicense, String>
    let see_alsos: List<String> = []
    match optional_field(j, "seeAlsos")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "ExtractedLicense.seeAlsos")?
            for x in xs
                see_alsos.push(as_string_or_err(x, "seeAlsos entry")?)

    return Ok(ExtractedLicense {
        license_id: as_string_or_err(field(j, "licenseId")?, "ExtractedLicense.licenseId")?,
        extracted_text: as_string_or_err(field(j, "extractedText")?, "ExtractedLicense.extractedText")?,
        name: string_field_or(j, "name", ""),
        see_alsos: see_alsos,
        comment: string_field_or(j, "comment", "")
    })

fun parse_extracted_licenses(items: List<JsonValue>) -> Result<List<ExtractedLicense>, String>
    let result: List<ExtractedLicense> = []
    for item in items
        result.push(parse_extracted_license(item)?)
    return Ok(result)

fun parse_package(j: JsonValue) -> Result<Package, String>
    let checksums: List<Checksum> = []
    match optional_field(j, "checksums")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "Package.checksums")?
            let parsed = parse_checksums(xs)?
            for c in parsed
                checksums.push(c)

    let annotations: List<Annotation> = []
    match optional_field(j, "annotations")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "Package.annotations")?
            let parsed = parse_annotations(xs)?
            for a in parsed
                annotations.push(a)

    return Ok(Package {
        spdx_id: as_string_or_err(field(j, "SPDXID")?, "Package.SPDXID")?,
        name: as_string_or_err(field(j, "name")?, "Package.name")?,
        version: string_field_or(j, "versionInfo", ""),
        download_location: string_field_or(j, "downloadLocation", "NOASSERTION"),
        license_concluded: string_field_or(j, "licenseConcluded", "NOASSERTION"),
        license_declared: string_field_or(j, "licenseDeclared", "NOASSERTION"),
        files_analyzed: bool_field_or(j, "filesAnalyzed", true),
        checksums: checksums,
        annotations: annotations
    })

fun parse_relationship(j: JsonValue) -> Result<Relationship, String>
    return Ok(Relationship {
        source: as_string_or_err(field(j, "spdxElementId")?, "Relationship.spdxElementId")?,
        kind: as_string_or_err(field(j, "relationshipType")?, "Relationship.relationshipType")?,
        target: as_string_or_err(field(j, "relatedSpdxElement")?, "Relationship.relatedSpdxElement")?
    })

// SPDX 2.3 ranges carry a ByteOffsetPointer or a LineCharPointer.
// This parser only supports the byte-offset shape; pointers
// with 'lineNumber' instead of 'offset' are rejected at parse
// time. Extending to line-pointers is mechanical.

fun parse_offset_pointer(j: JsonValue, context: String) -> Result<Int, String>
    return match optional_field(j, "offset")
        None -> Err("${context} pointer must carry 'offset' (line-pointer shape not supported)")
        Some(v) -> match v.as_num()
            None -> Err("${context} pointer 'offset' must be a number")
            Some(n) -> Ok(to_int(n))

fun parse_range(j: JsonValue) -> Result<Range, String>
    let start_p = field(j, "startPointer")?
    let end_p = field(j, "endPointer")?
    let start_offset = parse_offset_pointer(start_p, "startPointer")?
    let end_offset = parse_offset_pointer(end_p, "endPointer")?
    let reference = match optional_field(start_p, "reference")
        None -> ""
        Some(v) -> match v.as_string()
            None -> ""
            Some(s) -> s
    return Ok(Range {
        start_offset: start_offset,
        end_offset: end_offset,
        reference: reference
    })

fun parse_snippet(j: JsonValue) -> Result<Snippet, String>
    let ranges_arr = as_array_or_err(field(j, "ranges")?, "Snippet.ranges")?
    let ranges: List<Range> = []
    for r in ranges_arr
        ranges.push(parse_range(r)?)

    let license_info: List<String> = []
    match optional_field(j, "licenseInfoInSnippets")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "Snippet.licenseInfoInSnippets")?
            for x in xs
                license_info.push(as_string_or_err(x, "licenseInfoInSnippets entry")?)

    return Ok(Snippet {
        spdx_id: as_string_or_err(field(j, "SPDXID")?, "Snippet.SPDXID")?,
        snippet_from_file: as_string_or_err(field(j, "snippetFromFile")?, "Snippet.snippetFromFile")?,
        ranges: ranges,
        license_concluded: as_string_or_err(field(j, "licenseConcluded")?, "Snippet.licenseConcluded")?,
        license_info_in_snippets: license_info,
        name: string_field_or(j, "name", ""),
        comment: string_field_or(j, "comment", ""),
        copyright_text: as_string_or_err(field(j, "copyrightText")?, "Snippet.copyrightText")?
    })

fun parse_snippets(items: List<JsonValue>) -> Result<List<Snippet>, String>
    let result: List<Snippet> = []
    for item in items
        result.push(parse_snippet(item)?)
    return Ok(result)

fun parse_creation_info(j: JsonValue) -> Result<CreationInfo, String>
    let info = field(j, "creationInfo")?
    let created = as_string_or_err(field(info, "created")?, "creationInfo.created")?
    let creators_arr = as_array_or_err(field(info, "creators")?, "creationInfo.creators")?
    let creators: List<String> = []
    for x in creators_arr
        creators.push(as_string_or_err(x, "creator entry")?)
    return Ok(CreationInfo { created: created, creators: creators })

fun parse_document(j: JsonValue) -> Result<SpdxDocument, String>
    let packages: List<Package> = []
    match optional_field(j, "packages")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "document.packages")?
            for x in xs
                packages.push(parse_package(x)?)

    let relationships: List<Relationship> = []
    match optional_field(j, "relationships")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "document.relationships")?
            for x in xs
                relationships.push(parse_relationship(x)?)

    let annotations: List<Annotation> = []
    match optional_field(j, "annotations")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "document.annotations")?
            let parsed = parse_annotations(xs)?
            for a in parsed
                annotations.push(a)

    let extracted_licenses: List<ExtractedLicense> = []
    match optional_field(j, "hasExtractedLicensingInfos")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "document.hasExtractedLicensingInfos")?
            let parsed = parse_extracted_licenses(xs)?
            for el in parsed
                extracted_licenses.push(el)

    let snippets: List<Snippet> = []
    match optional_field(j, "snippets")
        None ->
            ()
        Some(v) ->
            let xs = as_array_or_err(v, "document.snippets")?
            let parsed = parse_snippets(xs)?
            for s in parsed
                snippets.push(s)

    return Ok(SpdxDocument {
        spdx_version: as_string_or_err(field(j, "spdxVersion")?, "spdxVersion")?,
        data_license: as_string_or_err(field(j, "dataLicense")?, "dataLicense")?,
        spdx_id: as_string_or_err(field(j, "SPDXID")?, "SPDXID")?,
        name: as_string_or_err(field(j, "name")?, "name")?,
        document_namespace: as_string_or_err(field(j, "documentNamespace")?, "documentNamespace")?,
        creation_info: parse_creation_info(j)?,
        packages: packages,
        relationships: relationships,
        annotations: annotations,
        extracted_licenses: extracted_licenses,
        snippets: snippets
    })

fun parse_spdx(json_text: String) -> Result<SpdxDocument, String>
    return match parse_json(json_text)
        Err(msg) -> Err("JSON parse error: ${msg}")
        Ok(j) -> parse_document(j)

// ---- validation: referential integrity ----
//
// An SPDX document is well-formed only if every Relationship's
// spdxElementId and relatedSpdxElement points at an SPDXID that
// the document actually defines. Dangling references are the
// most common source of malformed SBOMs in the wild and the
// signal a CRA auditor needs to flag a SBOM as untrustworthy.
//
// This validator runs after parsing and returns a List<String>
// of human-readable violations (empty list = the document is
// internally consistent). It is intentionally separate from the
// parser so that a syntactically-valid-but-semantically-broken
// SBOM still produces a typed AST that downstream consumers can
// inspect: the user gets BOTH the structure and the list of
// findings, instead of one or the other.

fun collect_spdx_ids(doc: SpdxDocument) -> Set<String>
    let ids: Set<String> = new_set()
    ids.add(doc.spdx_id)
    for p in doc.packages
        ids.add(p.spdx_id)
    return ids

fun validate_spdx(doc: SpdxDocument) -> List<String>
    let ids = collect_spdx_ids(doc)
    let errors: List<String> = []
    for r in doc.relationships
        if not ids.contains(r.source)
            errors.push("relationship source '${r.source}' is not a known SPDXID")
        if not ids.contains(r.target)
            errors.push("relationship target '${r.target}' is not a known SPDXID")
    for p in doc.packages
        for a in p.annotations
            if a.kind != "REVIEW" and a.kind != "OTHER"
                errors.push("package '${p.spdx_id}' has annotation with invalid type '${a.kind}'")
    for a in doc.annotations
        if a.kind != "REVIEW" and a.kind != "OTHER"
            errors.push("document has annotation with invalid type '${a.kind}'")
    for el in doc.extracted_licenses
        if not el.license_id.starts_with("LicenseRef-")
            errors.push("extracted license '${el.license_id}' must start with 'LicenseRef-'")
        if el.extracted_text == ""
            errors.push("extracted license '${el.license_id}' has empty extractedText")
    // Snippet validation: SPDXID prefix, at least one range, and
    // monotonic non-negative byte offsets. Note: snippet_from_file
    // is recorded but NOT checked against known SPDXIDs because
    // files[] parsing is a separate sub-item.
    for s in doc.snippets
        if not s.spdx_id.starts_with("SPDXRef-")
            errors.push("snippet '${s.spdx_id}' SPDXID must start with 'SPDXRef-'")
        if s.ranges.is_empty()
            errors.push("snippet '${s.spdx_id}' must have at least one range")
        for r in s.ranges
            if r.start_offset < 0 or r.end_offset < 0
                errors.push("snippet '${s.spdx_id}' has range with negative offset")
            if r.start_offset > r.end_offset
                errors.push("snippet '${s.spdx_id}' has range with start > end (${r.start_offset} > ${r.end_offset})")
    let cycle = detect_spdx_cycle(doc)
    match cycle
        None ->
            ()
        Some(node) ->
            errors.push("relationship graph contains a cycle through '${node}'")
    return errors

// ---- validation: cycle detection ----
//
// A well-formed SPDX document's relationship graph is a DAG: a
// supply-chain cycle ("A depends on B depends on A") is either a
// data-modelling error or a sign of corrupted provenance. We
// detect cycles with the classic three-colour DFS:
//
//   white: never visited (not in any set)
//   gray:  currently being visited (in `in_progress`)
//   black: fully visited (in `done`)
//
// Encountering a gray vertex means a back-edge, which means a
// cycle. We return Some(node) for the first gray vertex we hit
// (an arbitrary witness inside the cycle) and None when the
// graph is acyclic.
//
// Treats every Relationship as a directed edge from
// `spdxElementId` to `relatedSpdxElement`, regardless of type
// (DEPENDS_ON, CONTAINS, DESCRIBES, ...). A future refinement
// could classify cycles per relationship type; today, *any*
// cycle in the graph is the auditor's signal.

fun build_spdx_adj(doc: SpdxDocument) -> Map<String, List<String>>
    let adj: Map<String, List<String>> = new_map()
    for r in doc.relationships
        let existing = match adj.get(r.source)
            None -> []
            Some(xs) -> xs
        existing.push(r.target)
        adj.set(r.source, existing)
    return adj

fun has_cycle_from(
    adj: Map<String, List<String>>,
    node: String,
    in_progress: Set<String>,
    done: Set<String>
) -> Option<String>
    if done.contains(node)
        return None
    if in_progress.contains(node)
        return Some(node)
    in_progress.add(node)
    let children = match adj.get(node)
        None -> []
        Some(xs) -> xs
    for c in children
        match has_cycle_from(adj, c, in_progress, done)
            None ->
                ()
            Some(witness) ->
                return Some(witness)
    in_progress.remove(node)
    done.add(node)
    return None

fun detect_spdx_cycle(doc: SpdxDocument) -> Option<String>
    let adj = build_spdx_adj(doc)
    let in_progress: Set<String> = new_set()
    let done: Set<String> = new_set()
    let ids = collect_spdx_ids(doc)
    for n in ids.to_list()
        match has_cycle_from(adj, n, in_progress, done)
            None ->
                ()
            Some(witness) ->
                return Some(witness)
    return None

// ---- demo ----

fun main(stdio: Stdio)
    // A trimmed SPDX 2.3 document, just enough to exercise every
    // parser path: one package with two checksums plus one
    // DESCRIBES relationship. Capa string literals do not span
    // newlines in v1, so this is on a single line; in real
    // pipelines the SBOM comes from an Fs.read.
    let sample = "{\"spdxVersion\": \"SPDX-2.3\", \"dataLicense\": \"CC0-1.0\", \"SPDXID\": \"SPDXRef-DOCUMENT\", \"name\": \"capa-demo-sbom\", \"documentNamespace\": \"https://example.org/sbom/capa-demo-001\", \"creationInfo\": {\"created\": \"2026-05-13T10:00:00Z\", \"creators\": [\"Tool: capa-0.6\", \"Person: Nelson Duarte\"]}, \"packages\": [{\"SPDXID\": \"SPDXRef-Package-capa\", \"name\": \"capa\", \"versionInfo\": \"0.6.0-alpha\", \"downloadLocation\": \"https://github.com/nelsonduarte/capa-language\", \"licenseConcluded\": \"Apache-2.0\", \"licenseDeclared\": \"Apache-2.0\", \"filesAnalyzed\": true, \"checksums\": [{\"algorithm\": \"SHA1\", \"checksumValue\": \"aaaabbbbccccddddeeeeffffaaaabbbbccccdddd\"}, {\"algorithm\": \"SHA256\", \"checksumValue\": \"0011223344556677889900aabbccddeeff0011223344556677889900aabbccdd\"}], \"annotations\": [{\"annotator\": \"Tool: capa-0.6\", \"annotationDate\": \"2026-05-13T10:00:00Z\", \"annotationType\": \"OTHER\", \"comment\": \"summary:total_functions=42\"}]}], \"relationships\": [{\"spdxElementId\": \"SPDXRef-DOCUMENT\", \"relationshipType\": \"DESCRIBES\", \"relatedSpdxElement\": \"SPDXRef-Package-capa\"}], \"annotations\": [{\"annotator\": \"Tool: capa-0.6\", \"annotationDate\": \"2026-05-13T10:00:00Z\", \"annotationType\": \"OTHER\", \"comment\": \"document-level note\"}], \"hasExtractedLicensingInfos\": [{\"licenseId\": \"LicenseRef-AcmeProprietary\", \"extractedText\": \"Copyright (c) Acme Corp. All rights reserved. Redistribution requires written permission.\", \"name\": \"Acme Proprietary License\", \"seeAlsos\": [\"https://example.org/acme-license\"], \"comment\": \"Bundled in vendored third-party tarball\"}], \"snippets\": [{\"SPDXID\": \"SPDXRef-Snippet-1\", \"snippetFromFile\": \"SPDXRef-File-vendored-kernel-h\", \"ranges\": [{\"startPointer\": {\"offset\": 310, \"reference\": \"SPDXRef-File-vendored-kernel-h\"}, \"endPointer\": {\"offset\": 420, \"reference\": \"SPDXRef-File-vendored-kernel-h\"}}], \"licenseConcluded\": \"GPL-2.0-only\", \"licenseInfoInSnippets\": [\"GPL-2.0-only\"], \"name\": \"GPL helper\", \"comment\": \"Reused from a vendored kernel header\", \"copyrightText\": \"Copyright Linus Torvalds\"}]}"

    match parse_spdx(sample)
        Err(msg) ->
            stdio.eprintln("SPDX parse failed: ${msg}")
        Ok(doc) ->
            stdio.println("SPDX document: ${doc.name}")
            stdio.println("  version:   ${doc.spdx_version}")
            stdio.println("  namespace: ${doc.document_namespace}")
            stdio.println("  created:   ${doc.creation_info.created}")
            stdio.println("  creators:  ${doc.creation_info.creators.length()} entries")
            stdio.println("  annotations: ${doc.annotations.length()}")
            stdio.println("")
            stdio.println("Packages (${doc.packages.length()}):")
            for p in doc.packages
                stdio.println("  - ${p.name} ${p.version}")
                stdio.println("      license: ${p.license_concluded}")
                stdio.println("      checksums: ${p.checksums.length()}")
                for c in p.checksums
                    stdio.println("        ${c.algorithm} = ${c.value}")
                stdio.println("      annotations: ${p.annotations.length()}")
                for a in p.annotations
                    stdio.println("        ${a.kind} by ${a.annotator}: ${a.comment}")
            stdio.println("")
            stdio.println("Extracted licenses (${doc.extracted_licenses.length()}):")
            for el in doc.extracted_licenses
                stdio.println("  - ${el.license_id}")
                if el.name != ""
                    stdio.println("      name:     ${el.name}")
                if not el.see_alsos.is_empty()
                    stdio.println("      seeAlsos: ${el.see_alsos.length()}")
                    for url in el.see_alsos
                        stdio.println("        ${url}")
                if el.comment != ""
                    stdio.println("      comment:  ${el.comment}")
            stdio.println("")
            stdio.println("Relationships (${doc.relationships.length()}):")
            for r in doc.relationships
                stdio.println("  - ${r.source} -[${r.kind}]-> ${r.target}")
            stdio.println("")
            stdio.println("Snippets (${doc.snippets.length()}):")
            for s in doc.snippets
                if s.name != ""
                    stdio.println("  - ${s.spdx_id} (${s.name})")
                else
                    stdio.println("  - ${s.spdx_id}")
                stdio.println("      file:      ${s.snippet_from_file}")
                for r in s.ranges
                    stdio.println("      range:     ${r.start_offset}-${r.end_offset}")
                stdio.println("      license:   ${s.license_concluded}")
                stdio.println("      copyright: ${s.copyright_text}")
                if s.comment != ""
                    stdio.println("      comment:   ${s.comment}")
            stdio.println("")
            let violations = validate_spdx(doc)
            if violations.is_empty()
                stdio.println("Validation: ok (refs resolve + acyclic)")
            else
                stdio.println("Validation: ${violations.length()} issue(s)")
                for v in violations
                    stdio.println("  - ${v}")
