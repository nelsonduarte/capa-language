# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/
.python-version
# Isolated semgrep interpreter for the empirical study (T2 treatment).
# Semgrep's pinned deps must not contaminate the compiler venv, so it
# lives in its own venv that is recreated on demand (see the study README).
evaluation/empirical_study/.semgrep-venv/

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/
.ruff_cache/

# Editor / IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Per-machine editor session state
.claude/

# OS
.DS_Store
Thumbs.db
desktop.ini

# Local artefacts
*.bak
debug_out.bin
/tmp/

# Benchmark scratch (transpiled .py written next to each .capa
# by benchmarks/runner.py; regenerated on every run).
benchmarks/*.bench.py

# Agda interface cache (regenerated by `agda` on every typecheck).
*.agdai
proofs/MAlonzo/

# Long-form design / paper drafts are kept locally only. Capa is
# a personal project; the paper track is private until (and if) it
# turns into a venue submission.
Capa-WhitePaper.md
docs/paper-draft.md
capa-language-review.md
