// Characterization: every declared Map method, on all three backends.
// The keys / values / pairs prints pin insertion order (an overwrite of
// an existing key keeps its original position).

fun main(stdio: Stdio)
    let m = new_map()
    m.set("zeta", 1)
    m.set("alpha", 2)
    m.set("mid", 3)
    m.set("alpha", 4)
    stdio.println("length=${m.length()} is_empty=${m.is_empty()}")
    stdio.println("get_alpha=${m.get("alpha").unwrap_or(0)} get_missing=${m.get("nope").unwrap_or(0 - 1)}")
    stdio.println("contains_key=${m.contains_key("mid")} contains_key_no=${m.contains_key("nope")}")
    stdio.println("keys=${m.keys().fold("", fun (acc, k) => acc + k + ",")}")
    stdio.println("values=${m.values().fold("", fun (acc, v) => acc + "${v},")}")
    stdio.println("pairs=${m.pairs().fold("", fun (acc, p) => acc + "${p[0]}=${p[1]},")}")
    let e = new_map()
    stdio.println("empty_length=${e.length()} empty_is_empty=${e.is_empty()}")
    // filter: a FRESH map of the pairs satisfying pred(k, v), in the
    // receiver's insertion order. receiver_unchanged is the mutation
    // discriminator; the pairs print is the ORDER discriminator, which
    // would go red if either backend rebuilt the result in some other
    // order. The predicate reads both halves so a key-only or
    // value-only implementation cannot pass both rows.
    let big = m.filter(fun (k, v) => v > 2)
    stdio.println("filter_len=${big.length()} filter_pairs=${big.pairs().fold("", fun (acc, p) => acc + "${p[0]}=${p[1]},")}")
    stdio.println("filter_receiver_unchanged=${m.pairs().fold("", fun (acc, p) => acc + "${p[0]}=${p[1]},")}")
    let bykey = m.filter(fun (k, v) => k == "mid")
    let nothing = m.filter(fun (k, v) => v > 99)
    stdio.println("filter_by_key=${bykey.pairs().fold("", fun (acc, p) => acc + "${p[0]}=${p[1]},")} filter_empty=${nothing.length()} filter_empty_is_empty=${nothing.is_empty()}")
