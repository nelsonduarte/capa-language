@strict_ifc()
fun main(env: Env, stdio: Stdio)
    let k = env.get("API_KEY").unwrap_or("none")
    var i: Int = 0
    while i < 2
        i = i + 1
        let f = fun () =>
            if k.starts_with("s")
                return
            return
        f()
        stdio.println("loop body after lambda")
