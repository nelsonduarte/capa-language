fun may(k: String) -> Result<Int, String>
    if k.starts_with("s")
        return Err("no")
    return Ok(1)

@strict_ifc()
fun main(env: Env, _stdio: Stdio) -> Result<Unit, String>
    let k = env.get("API_KEY").unwrap_or("none")
    var n: Int = 0
    while n < 5
        n = n + 1
        let _v = may(k)?
    return Ok(())
