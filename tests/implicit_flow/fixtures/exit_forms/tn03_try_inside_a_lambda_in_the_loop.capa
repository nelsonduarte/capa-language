fun may(k: String) -> Result<Int, String>
    if k.starts_with("s")
        return Err("no")
    return Ok(1)

@strict_ifc()
fun main(env: Env, stdio: Stdio)
    let k = env.get("API_KEY").unwrap_or("none")
    var n: Int = 0
    while n < 5
        stdio.println("tick")
        n = n + 1
        let _f = fun () -> Result<Int, String> =>
            let v = may(k)?
            return Ok(v)
