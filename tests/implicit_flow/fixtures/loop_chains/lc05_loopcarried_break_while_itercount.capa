@strict_ifc()
fun main(env: Env, stdio: Stdio)
    let k = env.get("API_KEY").unwrap_or("none")
    var i: Int = 0
    var n: Int = 0
    var carried: Bool = false
    while i < 3
        i = i + 1
        n = n + 1
        if carried
            break
        carried = k.starts_with("s")
    stdio.println("n=${n}")
