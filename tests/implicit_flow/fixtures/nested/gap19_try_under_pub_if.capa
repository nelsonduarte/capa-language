fun may(k: String) -> Result<Int, String>
    if k.starts_with("s")
        return Err("no")
    return Ok(1)
@strict_ifc()
fun run(env: Env, stdio: Stdio) -> Result<Unit, String>
    let k = env.get("API_KEY").unwrap_or("none")
    let p: Int = 1
    if p == 1
        let v = may(k)?
    stdio.println("reached")
    return Ok(())
fun main(env: Env, stdio: Stdio)
    let _r = run(env, stdio)
