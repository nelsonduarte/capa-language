@strict_ifc()
fun main(env: Env, stdio: Stdio)
    let k = env.get("API_KEY").unwrap_or("none")
    var i: Int = 0
    var n: Int = 0
    while i < 3
        i = i + 1
        for j in 0..3
            n = n + 1
            if k.starts_with("s")
                break
        stdio.println("n=${n}")
