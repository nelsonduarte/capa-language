linear type Handle { id: Int }
fun open() -> Handle
    return Handle { id: 1 }
fun close(consume h: Handle) -> Unit
    return ()
fun main(stdio: Stdio)
    var n: Int = 0
    var i: Int = 0
    while i < 2
        i = i + 1
        let h = open()
        n = n + [h].length()
        close(h)
    stdio.println("n=${n}")
