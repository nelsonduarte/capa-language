@strict_ifc()
fun main(env: Env, stdio: Stdio)
    let k = env.get("API_KEY").unwrap_or("none")
    var lst: List<Int> = []
    var n: Int = 0
    for i in 0..6
        n = n + 1
        if lst.contains(1)
            break
        if k.starts_with("s")
            lst.push(1)
    stdio.println("n=${n}")
