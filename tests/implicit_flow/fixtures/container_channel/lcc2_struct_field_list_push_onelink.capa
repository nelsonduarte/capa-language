type Bag {
    items: List<Int>
}

@strict_ifc()
fun main(env: Env, stdio: Stdio)
    let k = env.get("API_KEY").unwrap_or("none")
    var bag: Bag = Bag { items: [] }
    var n: Int = 0
    for i in 0..6
        n = n + 1
        if not bag.items.is_empty()
            break
        if k.starts_with("s")
            bag.items.push(1)
    stdio.println("n=${n}")
