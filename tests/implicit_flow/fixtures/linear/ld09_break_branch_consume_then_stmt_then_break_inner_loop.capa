fun adoptar(consume stdio: Stdio)
    stdio.println("consumed")
fun main(stdio: Stdio)
    var i: Int = 0
    while i < 3
        i = i + 1
        if i == 5
            adoptar(stdio)
            let _z = 0
            break
        var j: Int = 0
        while j < 2
            j = j + 1
        stdio.println("still")
