linear type Handle { id: Int }
fun open() -> Handle
    return Handle { id: 1 }
fun close(consume h: Handle) -> Unit
    return ()
fun main(stdio: Stdio)
    let h = open()
    var i: Int = 0
    while true
        i = i + 1
        if i == 2
            close(h)
            break
    stdio.println("end")
