linear type Handle { id: Int }
fun open() -> Handle
    return Handle { id: 1 }
fun close(consume h: Handle) -> Unit
    return ()
fun main(stdio: Stdio)
    let h = open()
    let c = 1
    if c == 1
        let _a = 1
    elif c == 2
        close(h)
        panic("never")
    else
        let _b = 2
    close(h)
    stdio.println("end")
