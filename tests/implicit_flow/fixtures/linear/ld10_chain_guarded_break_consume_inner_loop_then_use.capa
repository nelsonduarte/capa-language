fun adoptar(consume stdio: Stdio)
    stdio.println("consumed")
fun main(stdio: Stdio)
    var i: Int = 0
    var c1: Bool = false
    var c2: Bool = false
    while i < 3
        i = i + 1
        if c2
            adoptar(stdio)
            break
        c2 = c1
        c1 = i == 5
        var j: Int = 0
        while j < 2
            j = j + 1
        stdio.println("still")
