linear type Handle { id: Int }
fun open() -> Handle
    return Handle { id: 1 }
fun close(consume h: Handle) -> Unit
    return ()
fun main(stdio: Stdio)
    let h = open()
    let c = true
    if c
        let _a = 1
    else
        close(h)
        panic("never")
    close(h)
    stdio.println("end")
