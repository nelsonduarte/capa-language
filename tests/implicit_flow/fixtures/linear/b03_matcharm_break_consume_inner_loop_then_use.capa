fun adoptar(consume stdio: Stdio)
    stdio.println("consumed")
fun main(stdio: Stdio)
    var i: Int = 0
    while i < 3
        i = i + 1
        match i
            5 ->
                adoptar(stdio)
                break
            _ ->
                let _z = 0
        var j: Int = 0
        while j < 2
            j = j + 1
        stdio.println("still")
