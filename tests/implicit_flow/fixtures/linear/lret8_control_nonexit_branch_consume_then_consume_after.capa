linear type Handle { id: Int }
fun open() -> Handle
    return Handle { id: 1 }
fun close(consume h: Handle) -> Unit
    return ()
fun noop() -> Unit
    return ()
fun main(stdio: Stdio)
    let h = open()
    let c = false
    if c
        close(h)
        noop()
    close(h)
    stdio.println("end")
