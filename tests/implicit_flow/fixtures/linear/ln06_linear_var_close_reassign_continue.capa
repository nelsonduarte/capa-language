linear type Handle { id: Int }
fun open() -> Handle
    return Handle { id: 1 }
fun close(consume h: Handle) -> Unit
    return ()
fun main(stdio: Stdio)
    var h = open()
    var i: Int = 0
    while i < 3
        i = i + 1
        if i == 1
            close(h)
            h = open()
            continue
    close(h)
    stdio.println("end")
