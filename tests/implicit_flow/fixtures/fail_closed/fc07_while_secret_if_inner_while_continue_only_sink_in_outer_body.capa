@strict_ifc()
fun main(env: Env, stdio: Stdio)
    let k = env.get("API_KEY").unwrap_or("none")
    let p: Int = 1
    var q: Int = 0
    while q < 3
        q = q + 1
        if k.starts_with("s")
            var r: Int = 0
            while r < 2
                r = r + 1
                if r == 1
                    continue
        stdio.println("reached")
