@strict_ifc()
fun main(env: Env, stdio: Stdio)
    let k = env.get("API_KEY").unwrap_or("none")
    var n: Int = 0
    let p: Int = 1
    for i in 0..5
        n = n + 1
        match p
            1 ->
                if k.starts_with("s")
                    break
            _ ->
                let _w = 0
    stdio.println("n=${n}")
