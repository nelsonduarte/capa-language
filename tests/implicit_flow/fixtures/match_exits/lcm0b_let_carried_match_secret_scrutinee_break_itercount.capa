@strict_ifc()
fun main(env: Env, stdio: Stdio)
    let k = env.get("API_KEY").unwrap_or("none")
    var n: Int = 0
    for i in 0..5
        n = n + 1
        let _r = match k.starts_with("s")
            v0 if v0 ->
                break
            _ ->
                0
    stdio.println("n=${n}")
